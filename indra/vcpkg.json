  "features": {
    "bugsplat": {
      "description": "Build with support for Bugsplat crash reporting",
      "dependencies": [
        {
          "name": "bugsplat",
          "platform": "windows & x64"
        },
        {
          "name": "bugsplat-apple",
          "platform": "osx"
        }
      ]
    },
    "kdu": {
      "description": "Build with support for Kakadu JPEG2000",
      "dependencies": [
        "kdu"
      ]
    },
    "openxr": {
      "description": "Build with support for OpenXR(experimental)",
      "dependencies": [
        "openxr-loader"
      ]
    },
    "sdl3": {
      "description": "Build with platform independent SDL window backend",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "dbus",
            "ibus",
            "wayland",
            "x11"
          ]
        }
      ]
    },
    "sentry": {
      "description": "Build with support for Sentry crash reporting",
      "dependencies": [
        {
          "name": "sentry-native",
          "platform": "windows | linux"
        },
        {
          "name": "sentry-cocoa",
          "platform": "osx"
        }
      ]
    },
    "tracy": {
      "description": "Build with Tracy profiler support",
      "dependencies": [
        "tracy"
      ]
    },
    "tracy-gui": {
      "description": "Build with Tracy profiler GUI support",
      "dependencies": [
        {
          "name": "tracy",
          "features": [
            "gui-tools"
          ]
        }
      ]
    },
    "tracy-local": {
      "description": "Build with Tracy profiler with localhost only",
      "dependencies": [
        {
          "name": "tracy",
          "features": [
            "localhost"
          ]
        }
      ]
    },
    "tracy-on-demand": {
      "description": "Build with Tracy profiler support",
      "dependencies": [
        {
          "name": "tracy",
          "features": [
            "on-demand"
          ]
        }
      ]
    },
    "velopack": {
      "description": "Build with support for the Velopack install and update framework",
      "dependencies": [
        "velopack"
      ]
    }
  }
}
