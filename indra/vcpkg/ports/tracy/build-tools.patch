diff --git a/CMakeLists.txt b/CMakeLists.txt
index 073fb6f..e281952 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -295,3 +295,21 @@ endif()
 if(PROJECT_IS_TOP_LEVEL)
     set(CMAKE_COLOR_DIAGNOSTICS ON)
 endif()
+
+option(VCPKG_CLI_TOOLS "library" OFF)
+option(VCPKG_GUI_TOOLS "library" OFF)
+if(VCPKG_GUI_TOOLS)
+    # vendor.cmake is include-guarded, so the first tool to include it fixes
+    # whether the GUI dependencies are looked up at all. VENDOR_GUI is set here
+    # so that answer does not depend on which tool that is.
+    set(VENDOR_GUI ON)
+endif()
+if(VCPKG_CLI_TOOLS)
+    add_subdirectory(csvexport)
+    add_subdirectory(capture)
+    add_subdirectory(import)
+    add_subdirectory(update)
+endif()
+if(VCPKG_GUI_TOOLS)
+    add_subdirectory(profiler)
+endif()
diff --git a/cmake/GitRef.cmake b/cmake/GitRef.cmake
index cbb9110..d5c3348 100644
--- a/cmake/GitRef.cmake
+++ b/cmake/GitRef.cmake
@@ -18,12 +18,6 @@ function(add_git_ref target)
             )
         else()
             message(WARNING "git not found, using 'unknown' as git ref.")
-            add_custom_command(
-                OUTPUT GitRef.hpp
-                COMMAND ${CMAKE_COMMAND} -E echo "#pragma once" > GitRef.hpp
-                COMMAND ${CMAKE_COMMAND} -E echo "namespace tracy { static inline const char* GitRef = \"unknown\"; }" >> GitRef.hpp
-                VERBATIM
-            )
         endif()
     endif()
 
@@ -32,6 +26,10 @@ function(add_git_ref target)
     if(_git_found)
         add_dependencies(${target} git-ref)
     else()
-        target_sources(${target} PUBLIC GitRef.hpp)
+        # Written per calling directory, because each target searches only its
+        # own binary dir for the header.
+        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/GitRef.hpp" [[#pragma once
+namespace tracy { static inline const char* GitRef = "unknown"; }
+]])
     endif()
 endfunction()
