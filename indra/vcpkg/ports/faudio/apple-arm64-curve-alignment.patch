Force pointer-alignment on static F3DAUDIO_DISTANCE_CURVE instances.

F3DAudio.h wraps its public structs in `#pragma pack(push, 1)`, so
F3DAUDIO_DISTANCE_CURVE (whose first field is a pointer `pPoints`)
has alignment 1. Apple's arm64 linker (Xcode 26 / ld-prerelease) now
refuses to merge globals when a pointer relocation lands at a
non-8-byte-aligned offset inside `__MergedGlobals`, e.g.:

  ld: pointer not aligned in '_F3DAudioCalculate.lpfReverbDefault'

Force the static curves to pointer alignment so pPoints stays
naturally aligned regardless of how the linker lays them out. Gated
on GCC/Clang attribute support so the Windows / MSVC build is
unaffected.

--- a/src/F3DAudio.c
+++ b/src/F3DAudio.c
@@ -30,6 +30,12 @@
 #include <math.h> /* ONLY USE THIS FOR isnan! */
 #include <float.h> /* ONLY USE THIS FOR FLT_MIN/FLT_MAX! */

+#if defined(__GNUC__) || defined(__clang__)
+#define FAUDIO_CURVE_ALIGN __attribute__((aligned(8)))
+#else
+#define FAUDIO_CURVE_ALIGN
+#endif
+
 /* VS2010 doesn't define isnan (which is C99), so here it is. */
 #if defined(_MSC_VER) && !defined(isnan)
 #define isnan(x) _isnan(x)
@@ -1450,8 +1456,8 @@ uint32_t F3DAudioCalculate(
 		{ \
 			{ x1, y1 }, \
 			{ x2, y2 } \
 		}; \
-		static F3DAUDIO_DISTANCE_CURVE name##Default = \
+		static F3DAUDIO_DISTANCE_CURVE FAUDIO_CURVE_ALIGN name##Default = \
 		{ \
 			(F3DAUDIO_DISTANCE_CURVE_POINT*) &name##Points[0], 2 \
 		};
--- a/src/FACT3D.c
+++ b/src/FACT3D.c
@@ -26,6 +26,12 @@

 #include "FACT3D.h"

+#if defined(__GNUC__) || defined(__clang__)
+#define FAUDIO_CURVE_ALIGN __attribute__((aligned(8)))
+#else
+#define FAUDIO_CURVE_ALIGN
+#endif
+
 uint32_t FACT3DInitialize(
 	FACTAudioEngine *pEngine,
 	F3DAUDIO_HANDLE F3DInstance
@@ -69,7 +75,7 @@ uint32_t FACT3DCalculate(
 		{ 0.0f, 1.0f },
 		{ 1.0f, 1.0f }
 	};
-	static F3DAUDIO_DISTANCE_CURVE DefaultCurve =
+	static F3DAUDIO_DISTANCE_CURVE FAUDIO_CURVE_ALIGN DefaultCurve =
 	{
 		(F3DAUDIO_DISTANCE_CURVE_POINT*) &DefaultCurvePoints[0], 2
 	};
