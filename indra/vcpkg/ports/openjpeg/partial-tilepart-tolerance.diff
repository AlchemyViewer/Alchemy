+        opj_read_bytes((OPJ_BYTE *)(data + pos + 2), &seg_length, 2);
+        if (seg_length < 2) {
+            return OPJ_FALSE;
+        }
+        next_pos = pos + 2 + (OPJ_SIZE_T)seg_length;
+        if (next_pos <= pos || next_pos > size) {
+            return OPJ_FALSE;
+        }
+        pos = next_pos;
