+OPJ_API OPJ_BOOL OPJ_CALLCONV opj_j2k_walk_tile_part_ends(
+    const OPJ_BYTE *data,
+    OPJ_SIZE_T size,
+    OPJ_SIZE_T *out_ends,
+    OPJ_UINT32 *out_num_ends,
+    OPJ_UINT32 max_ends,
+    OPJ_BOOL *out_complete)
