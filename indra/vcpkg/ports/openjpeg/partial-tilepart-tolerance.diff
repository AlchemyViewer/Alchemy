+        OPJ_SIZE_T next_pos;
+        OPJ_BYTE marker_low;
+
+        if (data[pos] != 0xFF) {
+            return OPJ_FALSE;
+        }
+        marker_low = data[pos + 1];
+
+        if (marker_low == 0x90) { /* SOT */
+            break;
+        }
+        if (marker_low == 0xD9) { /* EOC -- shouldn't appear in main header */
+            return OPJ_FALSE;
+        }
+        if (marker_low == 0x4F || marker_low == 0x91 || marker_low == 0x92) {
+            /* SOC / SOP / EPH have no Lseg and shouldn't appear here. */
+            return OPJ_FALSE;
+        }
