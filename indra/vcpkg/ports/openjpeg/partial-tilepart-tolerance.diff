+    OPJ_UINT32 num_ends = 0;
+    OPJ_BOOL saw_psot_zero = OPJ_FALSE;
+    OPJ_BOOL last_tp_fully_present = OPJ_FALSE;
+    OPJ_UINT32 first_tnsot = 0;
+    OPJ_BOOL have_first_tnsot = OPJ_FALSE;
+
+    if (out_num_ends) {
+        *out_num_ends = 0;
+    }
+    if (out_complete) {
+        *out_complete = OPJ_FALSE;
+    }
+    if (!data || !out_ends || !out_num_ends || !out_complete || max_ends == 0) {
+        return OPJ_FALSE;
+    }
+    if (size < 6) {
+        return OPJ_FALSE;
+    }
+
+    /* SOC marker is FF 4F. */
+    if (data[0] != 0xFF || data[1] != 0x4F) {
+        return OPJ_FALSE;
+    }
+    pos = 2;
+
+    /* Skip main-header marker segments until we land on SOT (FF 90). Each
+     * marker segment after the marker ID starts with a 2-byte big-endian
