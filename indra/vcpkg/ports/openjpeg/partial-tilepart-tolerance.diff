+                && data[end_off]     == 0xFF
+                && data[end_off + 1] == 0xD9) {
+            *out_complete = OPJ_TRUE;
+        }
+    }
+
+    *out_num_ends = num_ends;
+    return OPJ_TRUE;
+}
