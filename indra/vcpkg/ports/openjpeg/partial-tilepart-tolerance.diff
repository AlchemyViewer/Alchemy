+    /* Walk SOT markers. A SOT segment is exactly 12 bytes. Psot is the
+     * tile-part length from the first byte of the SOT to the first byte
+     * of the next SOT (or EOC for the last tile-part). Psot=0 is the
+     * legal "extends to EOC" sentinel. TNsot (last byte) is the total
+     * tile-part count for this tile, or 0 if unknown. */
+    while (pos + 12 <= size && num_ends < max_ends) {
+        OPJ_UINT32 psot = 0;
+        OPJ_UINT32 tnsot;
+        OPJ_SIZE_T tile_part_end;
+
+        if (data[pos] != 0xFF || data[pos + 1] != 0x90) {
+            break;
+        }
+
+        opj_read_bytes((OPJ_BYTE *)(data + pos + 6), &psot, 4);
+        tnsot = data[pos + 11];
+
+        if (!have_first_tnsot) {
+            first_tnsot = tnsot;
+            have_first_tnsot = OPJ_TRUE;
+        }
+
+        if (psot == 0) {
+            /* Extends to EOC -- use buffer end as the best cutoff. */
+            tile_part_end = size;
+            saw_psot_zero = OPJ_TRUE;
+        } else {
+            tile_part_end = pos + (OPJ_SIZE_T)psot;
+        }
+        if (tile_part_end <= pos || tile_part_end > 0x7FFFFFFFu) {
+            break;
+        }
+
+        out_ends[num_ends++] = tile_part_end;
+        last_tp_fully_present = (tile_part_end <= size) ? OPJ_TRUE : OPJ_FALSE;
+
+        if (psot == 0 || tile_part_end > size) {
+            /* Definitively the last tile-part, or the declared end
+             * extends past available bytes -- no more SOTs to walk. */
+            break;
+        }
+        pos = tile_part_end;
+    }
+
+    if (num_ends == 0) {
+        return OPJ_FALSE;
+    }
+
+    /* Completeness assessment. */
+    if (saw_psot_zero) {
+        *out_complete = OPJ_TRUE;
+    } else if (have_first_tnsot && first_tnsot != 0
+               && num_ends == first_tnsot
+               && last_tp_fully_present) {
+        *out_complete = OPJ_TRUE;
+    } else if (last_tp_fully_present) {
+        OPJ_SIZE_T end_off = out_ends[num_ends - 1];
