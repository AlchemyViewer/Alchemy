<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget vocabulary of XUI, written out of the viewer's own
  registries by XUI Studio. Do not edit: regenerate it.

  It is permissive on purpose. A parameter may be written as an
  attribute or as a nested element, a value may be a name or the
  thing it names, and a colour, image, font or setting is a string
  whose vocabulary lives in another file. Nothing here can say
  "one of these two spellings", so nothing here tries; the tool's
  lint is where those are checked.

  Nothing is required, not even a parameter the block declares
  Mandatory: a widget's template in widgets/ supplies values the
  file then leaves out, and no schema can see that layer.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- A parameter element: its own leaves are the attributes of
       the tag that owns it, written with dots, so there is nothing
       left here to check. -->

  <!-- A number as XUI writes one, which is as C writes one: the
       literals carry a float suffix, bar_max="100.f". -->
  <xs:simpleType name="al_real">
    <xs:restriction base="xs:string">
      <xs:pattern value="[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?[fF]?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="al_any" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

