<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="floater_chat_alerts" title="Chat-Schlüsselwort-Hinweise">
	<sound_drop_target name="sound_drop_target"/>
	<check_box label="Hinweise aktivieren" name="alerts_check"/>
	<scroll_list draw_heading="true" name="alerts_list">
		<scroll_list.columns label="Schlüsselwort" name="alert_keyword"/>
	</scroll_list>
	<button label="Neu" name="alerts_new_btn"/>
	<button label="Löschen" name="alerts_delete_btn"/>
	<view_border name="divisor"/>
	<text name="alerts_keyword_label">
		Schlüsselwort:
	</text>
	<line_editor name="alerts_keyword"/>
	<check_box label="Groß-/Kleinschreibung" name="alerts_keyword_case"/>
	<text name="alerts_color_label">
		Markierungsfarbe:
	</text>
	<color_swatch name="alerts_highlight_color"/>
	<text name="alerts_sound_label">
		Sound abspielen:
	</text>
	<line_editor label="Inventarobjekt hier ablegen" name="alerts_sound_name"/>
	<icon name="alerts_sound_icon"/>
	<button name="alerts_sound_clear_btn"/>
	<text name="alerts_trigger_label">
		Auslösen bei:
	</text>
	<check_box label="Chat" name="alerts_trigger_chat"/>
	<check_box label="IMs" name="alerts_trigger_im"/>
	<check_box label="Gruppen" name="alerts_trigger_group"/>
	<button label="Eintrag speichern" name="alerts_save_btn"/>
	<button label="Eintrag zurücksetzen" name="alerts_revert_btn"/>
</floater>
