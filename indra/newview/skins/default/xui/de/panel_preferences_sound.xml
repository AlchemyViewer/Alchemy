<?xml version="1.0" ?>
<panel label="Sounds" name="Preference Media panel">
	<panel.string name="middle_mouse">Mittlere Maustaste</panel.string>
    <tab_container name="sound_prefs_tab_container">
    <panel name="general_sound_panel">
	<slider label="Master-Lautstärke" name="System Volume"/>
	<check_box name="mute_when_minimized" label="Stummschalten, wenn minimiert"/>
	<slider label="Schaltflächen" name="UI Volume"/>
	<slider label="Umgebung" name="Wind Volume"/>
	<slider label="Soundeffekte" name="SFX Volume"/>
	<slider label="Gestreamte Musik" name="Music Volume"/>
	<check_box label="Aktiviert" name="enable_music"/>
	<slider label="Medien" name="Media Volume"/>
	<check_box label="Aktiviert" name="enable_media"/>
	<slider label="Voice-Chat" name="Voice Volume"/>
	<check_box label="Aktiviert" name="enable_voice_check"/>
	<check_box label="Automatische Wiedergabe zulassen" name="media_auto_play_btn" tool_tip="Hier aktivieren, um Medien automatisch wiederzugeben." value="true"/>
	<check_box label="Medien, die an andere Avatare angehängt sind, wiedergeben." name="media_show_on_others_btn" tool_tip="Diese Option deaktivieren, um Medien für andere Avataren, die sich in der Nähe befinden, auszublenden." value="true"/>
	<check_box label="Sounds von Gesten abspielen" name="gesture_audio_play_btn" tool_tip="Markieren, um Sounds von Gesten zu hören" value="true"/>
	<text name="audio_output_device_label">Ausgabegerät:</text>
	<text name="audio_reverb_label">Reverb-Preset:</text>
    <combo_box name="audio_reverb_combo">
        <item name="reverb_default"       label="Standard"/>
        <item name="reverb_generic"       label="Generisch"/>
        <item name="reverb_paddedcell"    label="Gepolsterte Zelle"/>
        <item name="reverb_room"          label="Zimmer"/>
        <item name="reverb_bathroom"      label="Badezimmer"/>
        <item name="reverb_livingroom"    label="Wohnzimmer"/>
        <item name="reverb_stoneroom"     label="Stein Zimmer"/>
        <item name="reverb_auditorium"    label="Auditorium"/>
        <item name="reverb_concerthall"   label="Konzerthalle"/>
        <item name="reverb_cave"          label="Höhle"/>
        <item name="reverb_arena"         label="Arena"/>
        <item name="reverb_hangar"        label="Hangar"/>
        <item name="reverb_carpetedhallway" label="Flur mit Teppichboden"/>
        <item name="reverb_hallway"       label="Korridor"/>
        <item name="reverb_stonecorridor" label="Stein Gasse"/>
        <item name="reverb_alley"         label="Gasse"/>
        <item name="reverb_forest"        label="Wald"/>
        <item name="reverb_city"          label="Stadt"/>
        <item name="reverb_mountains"     label="Gebirge"/>
        <item name="reverb_quarry"        label="Steinbruch"/>
        <item name="reverb_plain"         label="Draußen (Wiese)"/>
        <item name="reverb_parkinglot"    label="Parkplatz"/>
        <item name="reverb_sewerpipe"     label="Abwasserrohr"/>
        <item name="reverb_underwater"    label="Unterwasser"/>
        <item name="reverb_smallroom"     label="Kleines Zimmer"/>
    </combo_box>
	<text name="voice_chat_settings">Voice-Chat-Einstellungen</text>
	<line_editor label="Auslöser für Zum-Sprechen-drücken:" name="modifier_combo"/>
	<button label="Taste festlegen" name="set_voice_hotkey_button"/>
	<button name="set_voice_middlemouse_button" tool_tip="Auf mittlere Maustaste zurücksetzen"/>
	<panel label="Geräte-Einstellungen" name="device_settings_panel"/>
	<combo_box name="media_auto_play_combo">
		<item name="autoplay_enabled" label="Ja"/>
		<item name="autoplay_ask" label="Fragen"/>
		<item name="autoplay_disabled" label="Nein"/>
	</combo_box>
	</panel>
	<panel name="voice_sound_panel">
  	<text name="noise_suppression_label">Mikrofongeräuschreduzierung:</text>
	<combo_box name="noise_suppression_combo">
    	<item label="Off" name="noise_suppression_none"/>
    	<item label="Low" name="noise_suppression_low"/>
    	<item label="Moderate" name="noise_suppression_moderate"/>
    	<item label="High" name="noise_suppression_high"/>
    	<item label="Max" name="noise_suppression_max"/>
  	</combo_box>
	<text name="Listen from">Zuhören von:</text>
	<check_box label="Avatarlippen beim Sprechen bewegen" name="enable_lip_sync"/>
	<check_box left="260" name="voice_automatic_gain_control" label="Automatische Mikrofon-Empfindlichkeit" tool_tip="Check to enable automatic gain control"/>
	<check_box left="260" name="enable_echo_cancellation" label="Echounterdrückung" tool_tip="Aktivieren zur Sprach-Echounterdrückung."/>
	<check_box label="Sprachfunktion mit Knopf umschalten" name="push_to_talk_toggle_check" tool_tip="Wenn der Umschaltmodus aktiviert ist, drücken Sie die Auslöse-Taste EINMAL, um Ihr Mikrofon ein- oder auszuschalten. Wenn der Umschaltmodus nicht aktiviert ist, ist das Mikrofon nur dann eingeschaltet, wenn Sie die Auslösetaste gedrückt halten."/>
  	<check_box name="voice_dot_visualizer" label="Voice-Punkt über Avataren anzeigen" tool_tip="Aktivieren Sie die Option, den Voice-Punkt über den Avataren anzuzeigen, wenn diese mit dem Voice-chat verbunden sind."/>
	<button label="Eingabe-/Ausgabegeräte" name="device_settings_btn"/>
	<combo_box name="ear_location_combo">
		<item label="Kameraposition" name="camera_position"/>
		<item label="Avatarposition" name="avatar_position"/>
	</combo_box>
	</panel>
	</tab_container>
</panel>
