<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="floater_chat_alerts" title="Sohbet anahtar kelime uyarıları">
	<sound_drop_target name="sound_drop_target"/>
	<check_box label="Uyarıları etkinleştir" name="alerts_check"/>
	<scroll_list draw_heading="true" name="alerts_list">
		<scroll_list.columns label="Anahtar kelime" name="alert_keyword"/>
	</scroll_list>
	<button label="Yeni" name="alerts_new_btn"/>
	<button label="Sil" name="alerts_delete_btn"/>
	<view_border name="divisor"/>
	<text name="alerts_keyword_label">
		Anahtar kelime:
	</text>
	<line_editor name="alerts_keyword"/>
	<check_box label="Büyük/küçük harfe duyarlı" name="alerts_keyword_case"/>
	<text name="alerts_color_label">
		Vurgu rengi:
	</text>
	<color_swatch name="alerts_highlight_color"/>
	<text name="alerts_sound_label">
		Ses çal:
	</text>
	<line_editor label="Envanter öğesini buraya sürükleyin" name="alerts_sound_name"/>
	<icon name="alerts_sound_icon"/>
	<button name="alerts_sound_clear_btn"/>
	<text name="alerts_trigger_label">
		Tetikleyiciler:
	</text>
	<check_box label="Sohbet" name="alerts_trigger_chat"/>
	<check_box label="AM" name="alerts_trigger_im"/>
	<check_box label="Gruplar" name="alerts_trigger_group"/>
	<button label="Girdiyi kaydet" name="alerts_save_btn"/>
	<button label="Girdiyi geri al" name="alerts_revert_btn"/>
</floater>
