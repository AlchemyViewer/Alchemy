<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_dir_events" label="イベント">
	<string name="searching_text">
		検索しています…
	</string>
	<string name="not_found_text">
		見つかりませんでした。
	</string>
	<text name="find">
		検索語句を入力：
	</text>
	<combo_box name="category_combo">
		<combo_item name="All" label="全カテゴリ"/>
		<combo_item name="Discussion" label="討論"/>
		<combo_item name="Sports" label="スポーツ"/>
		<combo_item name="LiveMusic" label="ライブミュージック"/>
		<combo_item name="LiveDJ" label="ライブＤＪ"/>
		<combo_item name="Commercial" label="商用"/>
		<combo_item name="Nightlife/Entertainment" label="夜の生活／エンターティメント"/>
		<combo_item name="Games/Contests" label="ゲーム／コンテスト"/>
		<combo_item name="Pageants" label="野外劇"/>
		<combo_item name="Education" label="教育"/>
		<combo_item name="ArtsandCulture" label="芸術と文化"/>
		<combo_item name="Charity/SupportGroups" label="チャリティー／サポートグループ"/>
		<combo_item name="Miscellaneous" label="その他"/>
	</combo_box>
	<scroll_list name="results">
		<column name="name" label="名前"/>
		<column name="date" label="時間（ＰＴ）"/>
		<column name="time" label="時間"/>
	</scroll_list>
	<button name="prev_btn" tool_tip="前のページに戻ります。"/>
	<button name="next_btn" tool_tip="次のページに進みます。"/>
	<radio_group name="date_mode">
		<radio_item name="current" label="進行中及び今後のイベント"/>
		<radio_item name="date" label="日付"/>
	</radio_group>
	<button name="back_btn" label="«" label_selected="«" tool_tip="１日戻る"/>
	<button name="forward_btn" label="»" label_selected="»" tool_tip="１日進める"/>
	<button name="Search" label="検索"/>
</panel>
