<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel label="テキストチャット" name="preferences_chat_general">
	<panel name="general_chat_settings">
		<check_box label="ローカルチャットでジェスチャーを自動補完する" name="auto_complete_gestures"/>
		<check_box label="チャット時にタイピングアニメーションを再生する" name="play_typing_animation"/>
		<text name="email_settings">[https://accounts.secondlife.com/change_email?lang=ja-JP オフライン時のＩＭのメール送信先の設定]</text>
		<text name="font_size" width="70" left="296">
			サイズ：
		</text>
		<combo_box name="chat_font_size">
			<item label="小" name="Small"/>
			<item label="中" name="Medium"/>
			<item label="大" name="Large"/>
		</combo_box>
		<check_box label="吹き出しチャット" name="bubble_text_chat"/>
	</panel>
	<panel name="log_settings">
		<text name="logging_label">
			保存：
		</text>
		<combo_box name="conversation_log_combo">
			<item label="ログと会話履歴" name="log_and_transcripts"/>
			<item label="ログのみ" name="log_only"/>
			<item label="ログか会話履歴なし" name="no_log_or_transcript"/>
		</combo_box>
		<button label="ログをクリア…" name="clear_log"/>
		<button label="会話履歴を削除…" name="delete_transcripts"/>
		<text name="log_location_label">
			場所：
		</text>
		<line_editor name="log_path_string"/>
		<button label="参照…" label_selected="参照…" name="log_path_button"/>
	</panel>
	<button label="翻訳…" name="ok_btn"/>
	<button name="autoreplace_showgui" label="自動置換…"/>
	<button name="spellcheck_showgui" label="スペルチェック…"/>
</panel>
