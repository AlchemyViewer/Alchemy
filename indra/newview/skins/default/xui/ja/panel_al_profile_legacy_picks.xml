<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_profile_picks" label="ピック">
	<text name="picks_panel_text">
		ピックなし
	</text>
	<accordion name="accordion">
		<accordion_tab name="tab_picks" title="ピック"/>
		<accordion_tab name="tab_classifieds" title="クラシファイド広告"/>
	</accordion>
	<panel name="buttons_cucks">
		<layout_stack name="buttons_cucks_ls">
			<layout_panel name="add_btn_lp">
				<menu_button name="add_btn" tool_tip="項目を追加します"/>
			</layout_panel>
			<layout_panel name="info_btn_lp">
				<button name="info_btn" label="情報" tool_tip="ピックの情報を表示します"/>
			</layout_panel>
			<layout_panel name="teleport_btn_lp">
				<button name="teleport_btn" label="テレポート" tool_tip="該当する場所にテレポートします"/>
			</layout_panel>
			<layout_panel name="show_on_map_btn_lp">
				<button name="show_on_map_btn" label="マップ" tool_tip="該当する場所をワールドマップに表示します"/>
			</layout_panel>
		</layout_stack>
	</panel>
</panel>
