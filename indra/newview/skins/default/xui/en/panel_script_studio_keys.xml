    <panel.string name="cmd_unfold">Unfold</panel.string>
    <panel.string name="cmd_fold_all">Fold all</panel.string>
    <panel.string name="cmd_unfold_all">Unfold all</panel.string>
    <panel.string name="cmd_complete">Complete</panel.string>
    <panel.string name="cmd_signature_help">Parameter info</panel.string>
    <panel.string name="cmd_go_to_definition">Go to definition</panel.string>
    <panel.string name="cmd_find_references">Find references</panel.string>
    <panel.string name="cmd_rename">Rename symbol</panel.string>
    <panel.string name="cmd_find">Find</panel.string>
    <panel.string name="cmd_replace">Replace</panel.string>
    <panel.string name="cmd_find_next">Find next</panel.string>
    <panel.string name="cmd_find_previous">Find previous</panel.string>
    <panel.string name="cmd_quick_fix">Quick fix</panel.string>
    <panel.string name="cmd_next_misspelling">Next misspelling</panel.string>
    <panel.string name="cmd_join_lines">Join lines</panel.string>
    <panel.string name="cmd_previous_change">Previous edit location</panel.string>
    <panel.string name="cmd_next_change">Next edit location</panel.string>
    <panel.string name="cmd_next_function">Next function</panel.string>
    <panel.string name="cmd_previous_function">Previous function</panel.string>
    <panel.string name="cmd_select_function">Select the function</panel.string>
    <panel.string name="cmd_go_to_bracket">Go to the matching bracket</panel.string>
    <panel.string name="cmd_insert_line_below">Insert a line below</panel.string>
    <panel.string name="cmd_insert_line_above">Insert a line above</panel.string>
    <panel.string name="cmd_select_line">Select the line</panel.string>
    <panel.string name="cmd_move_subword_left">Move left one word part</panel.string>
    <panel.string name="cmd_move_subword_right">Move right one word part</panel.string>
    <panel.string name="cmd_select_subword_left">Select left one word part</panel.string>
    <panel.string name="cmd_select_subword_right">Select right one word part</panel.string>
    <panel.string name="cmd_expand_selection">Expand the selection</panel.string>
    <panel.string name="cmd_shrink_selection">Shrink the selection</panel.string>
    <panel.string name="cmd_select_next_occurrence">Select next occurrence</panel.string>
    <panel.string name="cmd_change_all_occurrences">Change all occurrences</panel.string>
    <panel.string name="cmd_previous_misspelling">Previous misspelling</panel.string>
    <text
     follows="left|top"
     height="22"
     layout="topleft"
     left="8"
     name="preset_label"
     top="8"
     valign="center"
     width="80">
        Keys like:
    </text>
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     left_pad="4"
     name="preset"
     tool_tip="Use the standard keys of another editor. Keys you have changed yourself still apply on top."
     top_delta="0"
     width="260" />
    <line_editor
     follows="left|top|right"
     height="22"
     label="Filter by command or key"
     layout="topleft"
     left="8"
     name="filter"
     tool_tip="Show only commands whose name or keys contain this text"
     top_pad="6"
     width="464" />
    <scroll_list
     follows="all"
     height="322"
     layout="topleft"
     left="8"
     name="keys"
     tool_tip="Editor and menu commands with their keys; double-click one to set new keys"
     top_pad="4"
     width="464">
        <scroll_list.columns dynamic_width="true" label="Command" name="command" />
        <scroll_list.columns label="Keys" name="keys" width="170" />
        <scroll_list.columns label="" name="changed" width="60" />
    </scroll_list>
    <text
     follows="left|right|bottom"
     height="16"
     layout="topleft"
     left="8"
     name="said"
     top_pad="4"
     use_ellipses="true"
     width="464" />
    <button
     follows="left|bottom"
     height="22"
     label="Change..."
     layout="topleft"
     left="8"
     name="change"
     tool_tip="Replace the selected command's keys; other commands using the new keys lose them"
     top_pad="4"
     width="80" />
    <button
     follows="left|bottom"
     height="22"
     label="Add..."
     layout="topleft"
     left_pad="4"
     name="add"
     tool_tip="Add another key to the selected command, keeping its current keys"
     top_delta="0"
     width="80" />
    <button
     follows="left|bottom"
     height="22"
     label="Clear"
     layout="topleft"
     left_pad="4"
     name="clear"
     tool_tip="Remove all keys from the selected command"
     top_delta="0"
     width="80" />
    <button
     follows="left|bottom"
     height="22"
     label="Reset"
     layout="topleft"
     left_pad="4"
     name="restore"
     tool_tip="Put back the selected command's keys as the chosen keymap has them"
     top_delta="0"
     width="80" />
    <button
     follows="right|bottom"
     height="22"
     label="Reset All"
     layout="topleft"
     name="restore_all"
     right="-8"
     tool_tip="Put back every command's keys as the chosen keymap has them, removing your own changes"
     top_delta="0"
     width="100" />
</panel>
