    <line_editor
     follows="left|top|right"
     height="22"
     label="Filter by command or key"
     layout="topleft"
     left="8"
     name="filter"
     tool_tip="Only the commands whose names or keys carry this"
     top="8"
     width="464" />
    <scroll_list
     follows="all"
     height="350"
     layout="topleft"
     left="8"
     name="keys"
     tool_tip="Every command of the editor and of the studio's menus, and its keys; double-click one to press a new key for it"
     top_pad="4"
     width="464">
        <scroll_list.columns dynamic_width="true" label="Command" name="command" />
        <scroll_list.columns label="Keys" name="keys" width="170" />
        <scroll_list.columns label="" name="changed" width="60" />
    </scroll_list>
    <text
     follows="left|right|bottom"
     height="16"
     layout="topleft"
     left="8"
     name="said"
     top_pad="4"
     use_ellipses="true"
     width="464" />
    <button
     follows="left|bottom"
     height="22"
     label="Change..."
     layout="topleft"
     left="8"
     name="change"
     tool_tip="Press a key to answer for the chosen command, in place of its keys; whatever answered to it before lets it go"
     top_pad="4"
     width="80" />
    <button
     follows="left|bottom"
     height="22"
     label="Add..."
     layout="topleft"
     left_pad="4"
     name="add"
     tool_tip="Press another key to answer for the chosen command, beside its keys"
     top_delta="0"
     width="80" />
    <button
     follows="left|bottom"
     height="22"
     label="Clear"
     layout="topleft"
     left_pad="4"
     name="clear"
     tool_tip="No key for the chosen command"
     top_delta="0"
     width="80" />
    <button
     follows="left|bottom"
     height="22"
     label="Standard"
     layout="topleft"
     left_pad="4"
     name="restore"
     tool_tip="The chosen command's standard keys again"
     top_delta="0"
     width="80" />
    <button
     follows="right|bottom"
     height="22"
     label="All Standard"
     layout="topleft"
     name="restore_all"
     right="-8"
     tool_tip="Every command's standard keys again"
     top_delta="0"
     width="100" />
</panel>
