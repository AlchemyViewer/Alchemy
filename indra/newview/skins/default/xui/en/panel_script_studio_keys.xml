<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Script Studio's keyboard map, a tab of its preferences: every
     command of the editor, and of the studio's menus, with the keys it
     answers to, to read, to search, and to change. A command answers to
     as many keys as it is given; a menu item shows the first. -->
<panel
 follows="all"
 height="440"
 layout="topleft"
 name="keys_panel"
 width="480">
    <panel.string name="NoKeys">(none)</panel.string>
    <panel.string name="preset_studio">Script Studio</panel.string>
    <panel.string name="preset_vscode">Visual Studio Code</panel.string>
    <panel.string name="preset_visual_studio">Visual Studio</panel.string>
    <panel.string name="preset_jetbrains">JetBrains (IntelliJ, Rider, CLion)</panel.string>
    <panel.string name="preset_xcode">Xcode</panel.string>
    <panel.string name="PresetChosen">Keys now match [NAME].</panel.string>
    <panel.string name="PresetChosenOwn">Keys now match [NAME]. Your own changes still apply on top; Reset All removes them.</panel.string>
    <panel.string name="Changed">changed</panel.string>
    <panel.string name="KeyTaken">[KEYS] is now assigned to [WHAT] and was removed from [WHOSE].</panel.string>
    <panel.string name="CaptureTitle">Keys for [WHAT]</panel.string>
    <panel.string name="CapturePrompt">Press a key. Press Return to set it, or Escape to cancel.</panel.string>
    <panel.string name="CapturePromptTwo">Press a key, or two keys in sequence (Ctrl+K, then S). Press Return to set them, or Escape to cancel.</panel.string>
    <panel.string name="CaptureNothing">Waiting for a key...</panel.string>
    <panel.string name="CaptureSet">Set</panel.string>
    <panel.string name="CaptureCancel">Cancel</panel.string>
    <panel.string name="CaptureTakes">Already used by [WHOSE], which will lose it.</panel.string>
    <panel.string name="CaptureShadows">The viewer menus use [KEYS] for [ITEM]; in Script Studio, this command takes priority.</panel.string>
    <panel.string name="cmd_move_left">Move left</panel.string>
    <panel.string name="cmd_move_right">Move right</panel.string>
    <panel.string name="cmd_move_up">Move up</panel.string>
    <panel.string name="cmd_move_down">Move down</panel.string>
    <panel.string name="cmd_move_word_left">Move left one word</panel.string>
    <panel.string name="cmd_move_word_right">Move right one word</panel.string>
    <panel.string name="cmd_move_line_start">Move to start of line</panel.string>
    <panel.string name="cmd_move_line_end">Move to end of line</panel.string>
    <panel.string name="cmd_move_doc_start">Move to the top</panel.string>
    <panel.string name="cmd_move_doc_end">Move to the bottom</panel.string>
    <panel.string name="cmd_move_page_up">Move up one page</panel.string>
    <panel.string name="cmd_move_page_down">Move down one page</panel.string>
    <panel.string name="cmd_select_left">Select left</panel.string>
    <panel.string name="cmd_select_right">Select right</panel.string>
    <panel.string name="cmd_select_up">Select up</panel.string>
    <panel.string name="cmd_select_down">Select down</panel.string>
    <panel.string name="cmd_select_word_left">Select left one word</panel.string>
    <panel.string name="cmd_select_word_right">Select right one word</panel.string>
    <panel.string name="cmd_select_line_start">Select to start of line</panel.string>
    <panel.string name="cmd_select_line_end">Select to end of line</panel.string>
    <panel.string name="cmd_select_doc_start">Select to the top</panel.string>
    <panel.string name="cmd_select_doc_end">Select to the bottom</panel.string>
    <panel.string name="cmd_select_page_up">Select up one page</panel.string>
    <panel.string name="cmd_select_page_down">Select down one page</panel.string>
    <panel.string name="cmd_select_all">Select all</panel.string>
    <panel.string name="cmd_delete_left">Delete left</panel.string>
    <panel.string name="cmd_delete_right">Delete right</panel.string>
    <panel.string name="cmd_delete_word_left">Delete left one word</panel.string>
    <panel.string name="cmd_delete_word_right">Delete right one word</panel.string>
    <panel.string name="cmd_delete_to_line_start">Delete to start of line</panel.string>
    <panel.string name="cmd_delete_to_line_end">Delete to end of line</panel.string>
    <panel.string name="cmd_new_line">New line</panel.string>
    <panel.string name="cmd_indent">Indent</panel.string>
    <panel.string name="cmd_unindent">Unindent</panel.string>
    <panel.string name="cmd_undo">Undo</panel.string>
    <panel.string name="cmd_redo">Redo</panel.string>
    <panel.string name="cmd_cut">Cut</panel.string>
    <panel.string name="cmd_copy">Copy</panel.string>
    <panel.string name="cmd_paste">Paste</panel.string>
    <panel.string name="cmd_delete">Delete</panel.string>
    <panel.string name="cmd_toggle_comment">Toggle comment</panel.string>
    <panel.string name="cmd_duplicate_line">Duplicate the line</panel.string>
    <panel.string name="cmd_move_line_up">Move the line up</panel.string>
    <panel.string name="cmd_move_line_down">Move the line down</panel.string>
