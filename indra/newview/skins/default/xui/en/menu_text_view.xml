<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The right-click menu of a text view: what the edit menu offers, routed
     to the view that showed it. -->
<context_menu
 name="Text view context menu">
  <menu_item_call label="Undo" layout="topleft" name="undo">
    <menu_item_call.on_click function="TextView.Perform" parameter="undo" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="undo" />
  </menu_item_call>
  <menu_item_call label="Redo" layout="topleft" name="redo">
    <menu_item_call.on_click function="TextView.Perform" parameter="redo" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="redo" />
  </menu_item_call>
  <menu_item_separator layout="topleft" />
  <menu_item_call label="Cut" layout="topleft" name="cut">
    <menu_item_call.on_click function="TextView.Perform" parameter="cut" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="cut" />
  </menu_item_call>
  <menu_item_call label="Copy" layout="topleft" name="copy">
    <menu_item_call.on_click function="TextView.Perform" parameter="copy" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="copy" />
  </menu_item_call>
  <menu_item_call label="Paste" layout="topleft" name="paste">
    <menu_item_call.on_click function="TextView.Perform" parameter="paste" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="paste" />
  </menu_item_call>
  <menu_item_call label="Delete" layout="topleft" name="delete">
    <menu_item_call.on_click function="TextView.Perform" parameter="delete" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="delete" />
  </menu_item_call>
  <menu_item_separator layout="topleft" />
  <menu_item_call label="Select All" layout="topleft" name="select_all">
    <menu_item_call.on_click function="TextView.Perform" parameter="select_all" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="select_all" />
  </menu_item_call>
</context_menu>
