    <layout_stack
     animate="false"
     follows="all"
     height="464"
     layout="topleft"
     left="8"
     name="main_stack"
     orientation="horizontal"
     top="70"
     width="1084"
     border_size="10"
     show_drag_handle="true"
     drag_handle_thickness="4"
     drag_handle_first_indent="10"
     drag_handle_second_indent="10"
     drag_handle_color="DkGray0"
     drag_handle_on_hover="true">
        <layout_panel
         auto_resize="false"
         expanded_min_dim="160"
         height="464"
         layout="topleft"
         min_dim="0"
         name="explorer_panel"
         user_resize="true"
         width="240"
         background_visible="true"
         background_opaque="true"
         bg_opaque_color="DkGray2"
         border="true">
            <scroll_list
             follows="all"
             height="438"
             layout="topleft"
             left="0"
             name="explorer"
             tool_tip="The objects in hand -- selected in world, or holding a script that is open -- and their scripts and notecards; double-click a script to open it"
             top="0"
             width="240">
                <scroll_list.columns dynamic_width="true" label="Name" name="name" />
                <scroll_list.columns label="Kind" name="kind" width="58" />
                <scroll_list.columns label="Run" name="run" width="34" />
            </scroll_list>
            <button
             follows="left|bottom"
             height="22"
             label="Open"
             layout="topleft"
             left="0"
             name="explorer_open"
             tool_tip="Open the chosen script"
             top_pad="4"
             width="46" />
            <button
             follows="left|bottom"
             height="22"
             label="Start"
             layout="topleft"
             left_pad="2"
             name="explorer_start"
             tool_tip="Set the chosen script running"
             top_delta="0"
             width="46" />
