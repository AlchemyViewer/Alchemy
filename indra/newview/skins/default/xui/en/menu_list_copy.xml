<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- The right-click menu of a list whose rows are worth taking away: the
     rows chosen, or every row, as text. -->
<context_menu
 name="List copy menu">
  <menu_item_call label="Copy" layout="topleft" name="copy">
    <menu_item_call.on_click function="List.Copy" />
    <menu_item_call.on_enable function="List.Enable" parameter="copy" />
  </menu_item_call>
  <menu_item_call label="Copy All" layout="topleft" name="copy_all">
    <menu_item_call.on_click function="List.CopyAll" />
    <menu_item_call.on_enable function="List.Enable" parameter="all" />
  </menu_item_call>
</context_menu>
