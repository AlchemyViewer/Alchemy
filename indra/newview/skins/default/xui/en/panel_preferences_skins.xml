<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 border="true"
 follows="left|top|right|bottom"
 height="408"
 label="Themes"
 layout="topleft"
 left="102"
 name="skins"
 top="1"
 width="517">
  <text
   type="string"
   length="1"
   follows="left|top"
   height="12"
   layout="topleft"
   left="30"
   name="select_skin_text"
   top="12"
   width="180">
   Select a Theme:
  </text>
  <!-- Chooser -->
  <scroll_list
   height="225"
   follows="left|top"
   layout="topleft"
   left="40"
   name="skin_list"
   draw_heading="false"
   top_pad="8"
   width="170">
    <scroll_list.commit_callback
     function="Pref.SelectSkin" />
  </scroll_list>
  <button
   enabled="true"
   follows="left|top"
   height="19"
   label="Apply"
   layout="topleft"
   left="40"
   name="apply_skin"
   tool_tip="Changes will take effect after you restart [APP_NAME]"
   top_pad="4"
   width="75">
    <button.commit_callback
     function="Pref.ApplySkin" />
  </button>
  <button
   enabled="true"
   follows="left|top"
   height="19"
   image_disabled="AddItem_Disabled"
   image_selected="AddItem_Press"
   image_unselected="AddItem_Off"
   layout="topleft"
   left_pad="52"
   name="add_skin"
   top_delta="0"
   tool_tip="Add a new theme..."
   width="19">
    <button.commit_callback
     function="Pref.AddSkin" />
  </button>
  <button
   enabled="false"
   follows="left|top"
   height="19"
   image_disabled="TrashItem_Disabled"
   image_selected="TrashItem_Press"
   image_unselected="TrashItem_Off"
   layout="topleft"
   left_pad="4"
   name="remove_skin"
   top_delta="0"
   tool_tip="Remove selected theme..."
   width="19">
    <button.commit_callback
     function="Pref.RemoveSkin" />
  </button>
  <!-- Info/Preview -->
  <text
   type="string"
   length="1"
   follows="left|top"
   height="20"
   layout="topleft"
   font="SansSerifLarge"
   left="215"
   name="skin_name"
   top="10"
   right="-10">
   Boring theme!
  </text>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_author_label"
   top_pad="2"
   width="90"
   value="Author:" />
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_homepage_label"
   top_pad="2"
   width="90"
   value="Homepage:" />
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_date_label"
   top_pad="2"
   width="90"
   value="Date:" />
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_compatibility_label"
   top_pad="2"
   width="90"
   value="Compatiblity:" />
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_author"
   top_delta="-48"
   left_pad="1"
   width="200">
Nobody
  </text>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_homepage"
   top_pad="2"
   width="200">
http://www.example.com/
  </text>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_date"
   top_pad="2"
   width="200">
Jan 1, 2001
  </text>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_compatibility"
   top_pad="2"
   width="200">
0.0.0
  </text>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   name="skin_notes_label"
   top_pad="2"
   left="215"
   width="90"
   value="Notes:" />
  <text
   type="string"
   length="1"
   follows="left|top"
   height="70"
   layout="topleft"
   name="skin_notes"
   top_pad="2"
   word_wrap="true"
   width="291" />
  <!-- Custom UI Fonts: live-applied via AlchemyUIFontOverrides setting.
       Combobox values are family names from fonts.xml; the line editor
       beside each lets the user type a font filename instead. Either
       resolves to an override entry; (default) clears the override. -->
  <text
   type="string"
   length="1"
   follows="left|top"
   height="14"
   layout="topleft"
   font="SansSerifBold"
   left="30"
   name="ui_fonts_header"
   top="290"
   width="400">
   Custom UI Fonts
  </text>
  <text
   type="string"
   length="1"
   follows="left|top"
   height="16"
   layout="topleft"
   left="40"
   name="ui_font_sansserif_label"
   top_pad="8"
   width="80">
   UI Font:
  </text>
  <combo_box
   follows="left|top"
   height="23"
   layout="topleft"
   left_pad="0"
   name="ui_font_sansserif"
   tool_tip="Override the SansSerif family used for most UI text. Pick a font family from fonts.xml or type a file name in the box at right."
   top_delta="-3"
   width="160">
    <combo_box.commit_callback
     function="Pref.UIFontSelected"
     parameter="SansSerifBase" />
  </combo_box>
  <!--<line_editor
   follows="left|top"
   height="23"
   layout="topleft"
   left_pad="6"
   name="ui_font_sansserif_file"
   tool_tip="Or type a font filename here (TrueType/OpenType/WOFF2). Cleared when the dropdown picks a built-in family."
   top_delta="0"
   width="180">
    <line_editor.commit_callback
     function="Pref.UIFontFileEntered"
     parameter="SansSerifBase" />
  </line_editor>-->
  <text
   type="string"
   length="1"
   follows="left|top"
   height="16"
   layout="topleft"
   left="40"
   name="ui_font_monospace_label"
   top_pad="6"
   width="80">
   Mono Font:
  </text>
  <combo_box
   follows="left|top"
   height="23"
   layout="topleft"
   left_pad="0"
   name="ui_font_monospace"
   tool_tip="Override the Monospace family used by code/script editors and inline mono text. Pick from fonts.xml families or supply a filename."
   top_delta="-3"
   width="160">
    <combo_box.commit_callback
     function="Pref.UIFontSelected"
     parameter="MonospaceBase" />
  </combo_box>
  <!--<line_editor
   follows="left|top"
   height="23"
   layout="topleft"
   left_pad="6"
   name="ui_font_monospace_file"
   tool_tip="Or type a font filename here (TrueType/OpenType/WOFF2). Cleared when the dropdown picks a built-in family."
   top_delta="0"
   width="180">
    <line_editor.commit_callback
     function="Pref.UIFontFileEntered"
     parameter="MonospaceBase" />
  </line_editor>-->
  <text
   type="string"
   length="1"
   follows="left|top"
   height="16"
   layout="topleft"
   left="40"
   name="ui_font_emoji_label"
   top_pad="6"
   width="80">
   Emoji Font:
  </text>
  <combo_box
   follows="left|top"
   height="23"
   layout="topleft"
   left_pad="0"
   name="ui_font_emoji"
   tool_tip="Override the color emoji font used everywhere emoji appear (chat, names, UI). Routes through EmojiBase so the swap propagates to every emoji-consuming chain with each chain's filter intact."
   top_delta="-3"
   width="160">
    <combo_box.commit_callback
     function="Pref.UIFontSelected"
     parameter="EmojiBase" />
  </combo_box>
</panel>
