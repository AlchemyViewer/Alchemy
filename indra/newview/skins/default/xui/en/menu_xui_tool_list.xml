<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<context_menu
 layout="topleft"
 name="menu_xui_tool_list">
    <menu_item_call
     label="Copy"
     name="copy">
        <menu_item_call.on_click
         function="XUITool.List"
         parameter="copy" />
        <menu_item_call.on_enable
         function="XUITool.ListEnabled"
         parameter="copy" />
    </menu_item_call>
    <menu_item_call
     label="Copy All"
     name="copy_all">
        <menu_item_call.on_click
         function="XUITool.List"
         parameter="copy_all" />
    </menu_item_call>
    <menu_item_separator />
    <menu_item_call
     label="Select All"
     name="select_all">
        <menu_item_call.on_click
         function="XUITool.List"
         parameter="select_all" />
    </menu_item_call>
</context_menu>
