  </menu_item_call>
  <menu_item_separator layout="topleft" />
  <menu_item_call label="Fold" layout="topleft" name="fold">
    <menu_item_call.on_click function="TextView.Perform" parameter="fold" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="fold" />
  </menu_item_call>
  <menu_item_call label="Unfold" layout="topleft" name="unfold">
    <menu_item_call.on_click function="TextView.Perform" parameter="unfold" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="unfold" />
  </menu_item_call>
  <menu_item_call label="Fold All" layout="topleft" name="fold_all">
    <menu_item_call.on_click function="TextView.Perform" parameter="fold_all" />
    <menu_item_call.on_enable function="TextView.Enable" parameter="fold_all" />
