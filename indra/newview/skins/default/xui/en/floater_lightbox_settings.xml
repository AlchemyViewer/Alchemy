<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 width="460"
 height="560"
 min_width="420"
 min_height="420"
 layout="topleft"
 name="floater_lightbox_settings"
 positioning="cascading"
 title="Lightbox"
 save_rect="true"
 can_resize="true">
	<!-- How a Look's name is shown once its settings have been changed. The
	     marker rides the name rather than sitting beside it as a separate
	     widget, so the state belongs to the thing it describes. -->
	<floater.string
	 name="look_name_modified">
		[NAME] *
	</floater.string>
	<!-- The badge on the Look tab while grading sections are switched off
	     for comparison: how many. The tab's tooltip says what the number
	     counts, since a badge has no tooltip of its own. -->
	<floater.string
	 name="bypass_badge">
		[COUNT]
	</floater.string>
	<floater.string
	 name="find_placeholder">
		Find a setting or section
	</floater.string>
	<!-- What the undo history calls its steps. A step made some other way is
	     called after the setting it changed, by the name its row shows. -->
	<floater.string
	 name="history_reset_section">
		Reset [SECTION]
	</floater.string>
	<floater.string
	 name="history_reset_setting">
		Reset [SETTING]
	</floater.string>
	<floater.string
	 name="history_look">
		Look: [NAME]
	</floater.string>
	<floater.string
	 name="history_revert">
		Revert to [NAME]
	</floater.string>
	<floater.string
	 name="history_white_balance">
		White balance pick
	</floater.string>
	<floater.string
	 name="history_settings">
		[COUNT] settings
	</floater.string>
	<floater.string
	 name="history_start">
		Start of history
	</floater.string>
	<floater.string
	 name="history_empty_headline">
		Nothing to undo yet
	</floater.string>
	<floater.string
	 name="history_empty_sentence">
		Each change to the grade is listed here as you make it. Double-click one to go back to it.
	</floater.string>
	<!-- The inline colour picker a colour row's swatch opens: the button that
	     goes on to the viewer's own picker, for typed numbers and the
	     eyedropper. -->
	<floater.string
	 name="color_full_picker">
		Full picker...
	</floater.string>
	<floater.string
	 name="color_full_picker_tooltip">
		Open the viewer's color picker, with typed values and the eyedropper, starting from the color picked here
	</floater.string>
	<!-- A tab taken out into a window of its own: the window's title, the
	     pop-out button's two tooltips, and what the tab says while its page
	     is away. -->
	<floater.string
	 name="pane_title">
		Lightbox: [TAB]
	</floater.string>
	<floater.string
	 name="pane_take_out_tooltip">
		Take the [TAB] tab out into a window of its own
	</floater.string>
	<floater.string
	 name="pane_put_back_tooltip">
		Put the [TAB] tab back in the Lightbox
	</floater.string>
	<floater.string
	 name="pane_away_headline">
		[TAB] is in a window of its own
	</floater.string>
	<floater.string
	 name="pane_away_sentence">
		Move that window wherever it is handy. Closing it puts the tab back here, and so does the button below.
	</floater.string>
	<floater.string
	 name="pane_put_back">
		Put it back
	</floater.string>
	<!-- The bar is split by what its buttons act on. This bar holds the
	     grade: which Look it is, and its history. The buttons that act on
	     how the floater is looked at (Scopes, Find, pop-out) sit at the
	     right end of the tab strip, beside the tabs they are about; they are
	     at the end of the tab_container below. Split that way, the bar no
	     longer sets min_width, and the Looks combo stretches with the floater
	     instead of being the fixed 150px that was left over. -->
	<panel
	 name="lightbox_topbar"
	 follows="left|top|right"
	 layout="topleft"
	 left="4"
	 top="18"
	 right="-4"
	 height="22">
		<!-- Everything left of the buttons, which are held to the right edge:
		     184 is the seven of them with their gaps, and 6 of margin. -->
		<combo_box
		 follows="left|top|right"
		 layout="topleft"
		 left="6"
		 top="1"
		 right="-184"
		 height="20"
		 name="looks_combo"
		 tool_tip="Apply a saved Look (a bundle of the aesthetic settings from the Look and Lens tabs). A * after the name means the settings have been changed since that Look was applied.">
			<combo_box.commit_callback
			 function="LightBox.LookSelected" />
		</combo_box>
		<!-- Icons rather than labels: four words would cost 192px of a bar
		     whose spare width is the Looks combo's to have. Every overlay
		     here is an existing 18px viewer icon, so the tooltip carries the
		     name. Save, Undo and Redo are all from the script editor's set,
		     which is why they sit together without looking assembled: a
		     floppy disk, not Cam_Save, which is a camcorder and reads as one.

		     Placed by `right` rather than `left_pad`, since they follow the
		     right edge: the last is 6 in from it, matching the combo's 6 at
		     the left, and each one before it is 24 further in (20 and a gap
		     of 4), plus 12 where the group changes. -->
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-158"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Script_Save"
		 name="look_save"
		 tool_tip="Save: overwrite the current Look with the settings as they are now">
			<button.commit_callback
			 function="LightBox.LookSave" />
		</button>
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-134"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Conv_toolbar_plus"
		 name="look_saveas"
		 tool_tip="Save As: save the current settings as a new Look">
			<button.commit_callback
			 function="LightBox.LookSaveAs" />
		</button>
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-110"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="TrashItem_Off"
		 name="look_delete"
		 tool_tip="Delete a saved Look">
			<button.commit_callback
			 function="LightBox.LookDelete" />
		</button>
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-86"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Refresh_Off"
		 name="look_revert"
		 tool_tip="Revert: discard changes and re-apply the last applied Look">
			<button.commit_callback
			 function="LightBox.LookRevert" />
		</button>
		<!-- Set apart from the four above: those act on the Look, these on the
		     grade's own history, and the gap is the only thing that says so. -->
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-54"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Script_Undo"
		 name="look_undo"
		 tool_tip="Undo the last grading change (Ctrl+Z). One drag of a control is one step.">
			<button.commit_callback
			 function="LightBox.Undo" />
		</button>
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-30"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Script_Redo"
		 name="look_redo"
		 tool_tip="Redo the change just undone (Ctrl+Y, or Ctrl+Shift+Z)">
			<button.commit_callback
			 function="LightBox.Redo" />
		</button>
		<!-- The same stack as the two above, as a list: in their group. -->
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-6"
		 top="1"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Conv_toolbar_call_log"
		 name="look_history"
		 tool_tip="History: every grading change since the Lightbox opened, by name. Double-click one to go back or forward to it.">
			<button.commit_callback
			 function="LightBox.History" />
		</button>
	</panel>
	<!-- fill_width shares the strip between the four tabs instead of leaving
	     the right-hand third of it empty. Each page's tool_tip is copied onto
	     its tab button when the page is added, which is where it belongs;
	     postBuild then clears it from the page itself, because a page's own
	     tooltip would otherwise pop up over every caption and gap on it.

	     tab_padding_right keeps the strip's right end for the three buttons
	     at the bottom of this element: fill_width shares out only what is
	     left (LLTabContainer::stripRoom), so the tabs stop 8px short of the
	     first button (451, the right of the pages, less 81, is 370). -->
	<tab_container
	 follows="all"
	 layout="topleft"
	 left="4"
	 top_pad="2"
	 right="-4"
	 height="512"
	 name="lightbox_tabs"
	 tab_position="top"
	 tab_min_width="70"
	 tab_padding_right="81"
	 fill_width="true">
		<panel
		 filename="panel_lightbox_look.xml"
		 label="Look"
		 layout="topleft"
		 name="tab_look"
		 tool_tip="Exposure and tone mapping, color grading, the 3D LUT and the tone curve. A number on this tab counts the grading sections switched off for comparison." />
		<panel
		 filename="panel_lightbox_lens.xml"
		 label="Lens"
		 layout="topleft"
		 name="tab_lens"
		 tool_tip="Camera and film effects: depth of field, bloom, glow, lens flare, chromatic aberration, vignette, grain and sharpening." />
		<panel
		 filename="panel_lightbox_scene.xml"
		 label="Scene"
		 layout="topleft"
		 name="tab_scene"
		 tool_tip="Render quality: anti-aliasing, reflections, mirrors, shadows and ambient occlusion, performance, and preview aids." />
		<!-- Last, because it is the odd one out: the other three hold settings
		     this floater owns, and this one also reaches out and changes the
		     world's environment. It is the one you use first, though, before
		     there is a grade to speak of, which is an argument for the other
		     end; fill_width gives the four tabs equal shares of the strip
		     whatever their order, so the order is free to change if that reads
		     better in use. -->
		<panel
		 filename="panel_lightbox_sky.xml"
		 label="Sky"
		 layout="topleft"
		 name="tab_sky"
		 tool_tip="The day cycle, which changes the world's environment for you, and sky effects drawn only on your screen." />
		<!-- The strip's own buttons: how the floater is looked at, beside the
		     tabs, where the bar above holds the grade. In the tab_container
		     and not laid over it as siblings: a tab_container makes a tab of
		     every panel it is given but keeps any other child as it is, and
		     inside it they overlap nothing. That is also why they are not
		     grouped in a panel of their own; a panel here would be a fifth
		     tab. They stay out of the tabs' mouse capture, which ends where
		     tab_padding_right begins.

		     Each sits under the matching button of the history group in the
		     bar above (right -54, -30, -6), so the two rows make one column
		     at the right edge. top="2" centres 20 in the strip's 23. -->
		<!-- Opens another window. Command_Stats_Icon is a bar graph and is the
		     same 18px as every other overlay here; it reads as what the
		     window opens with, since the first pane is a histogram.

		     Floater.Toggle, NOT Floater.ToggleOrBringToFront. The latter is
		     written for toolbar buttons and closes its target only in an
		     `else if (!instance->isFrontmost())` fall-through, so pressing a
		     button that lives in *another floater* can never reach it, because
		     that press makes this floater the frontmost one. From here it opens
		     and raises Scopes and nothing else, and the button has no way to
		     shut it again. Any "open that window" button added to this floater
		     has the same problem; reach for Floater.Toggle. -->
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-54"
		 top="2"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Command_Stats_Icon"
		 name="open_scopes"
		 tool_tip="Scopes: measure the frame you are grading -- histogram, waveform, parade and vectorscope, up to four at once. Click again to close.">
			<button.commit_callback
			 function="Floater.Toggle"
			 parameter="scopes" />
		</button>
		<!-- Finds a place among the tabs. The list it opens hangs from the bar
		     above and is as wide as it, so its field lands over this strip:
		     the row of tabs becomes the row you type into. -->
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-30"
		 top="2"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Command_Search_Icon"
		 name="lightbox_find"
		 tool_tip="Find a setting or section by name, and go to it (Ctrl+F)">
			<button.commit_callback
			 function="LightBox.Find" />
		</button>
		<!-- Acts on the tab that is up, so it sits at the end of the tabs. The
		     icon and tooltip are set from C++ to match that tab (while its
		     page is out, the button brings it back), so the ones here are
		     only the starting state. -->
		<button
		 follows="top|right"
		 layout="topleft"
		 right="-6"
		 top="2"
		 width="20"
		 height="20"
		 label=""
		 halign="center"
		 image_overlay="Conv_toolbar_arrow_ne"
		 name="lightbox_pop_out"
		 tool_tip="Take this tab out into a window of its own">
			<button.commit_callback
			 function="LightBox.PopOut" />
		</button>
	</tab_container>
</floater>
