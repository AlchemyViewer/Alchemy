<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 width="460"
 height="560"
 min_width="420"
 min_height="420"
 layout="topleft"
 name="floater_lightbox_settings"
 positioning="cascading"
 title="Lightbox"
 save_rect="true"
 can_resize="true">
	<panel
	 name="lightbox_topbar"
	 follows="left|top|right"
	 layout="topleft"
	 left="4"
	 top="18"
	 right="-4"
	 height="22">
		<!-- The Looks preset bar lands here in P4. (A "bypass post" toggle was
		     removed: RenderDisablePostProcessing only acts while build tools
		     are open, pipeline.cpp no_post gate.) -->
	</panel>
	<tab_container
	 follows="all"
	 layout="topleft"
	 left="4"
	 top_pad="2"
	 right="-4"
	 height="512"
	 name="lightbox_tabs"
	 tab_position="top"
	 tab_min_width="70">
		<panel
		 filename="panel_lightbox_look.xml"
		 label="Look"
		 layout="topleft"
		 name="tab_look" />
		<panel
		 filename="panel_lightbox_lens.xml"
		 label="Lens"
		 layout="topleft"
		 name="tab_lens" />
		<panel
		 filename="panel_lightbox_scene.xml"
		 label="Scene"
		 layout="topleft"
		 name="tab_scene" />
	</tab_container>
</floater>
