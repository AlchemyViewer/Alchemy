<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- The right-click menu of a studio pane's list whose rows are worth
     taking away (ALPaneList::setCopyable): the cell under the pointer, the
     rows chosen or every row, as a table to read. -->
<context_menu
 layout="topleft"
 name="menu_pane_list">
    <menu_item_call
     label="Copy Cell"
     name="copy_cell">
        <menu_item_call.on_click
         function="PaneList.Copy"
         parameter="copy_cell" />
        <menu_item_call.on_enable
         function="PaneList.CopyEnabled"
         parameter="copy_cell" />
    </menu_item_call>
    <menu_item_call
     label="Copy Rows"
     name="copy">
        <menu_item_call.on_click
         function="PaneList.Copy"
         parameter="copy" />
        <menu_item_call.on_enable
         function="PaneList.CopyEnabled"
         parameter="copy" />
    </menu_item_call>
    <menu_item_call
     label="Copy All Rows"
     name="copy_all">
        <menu_item_call.on_click
         function="PaneList.Copy"
         parameter="copy_all" />
        <menu_item_call.on_enable
         function="PaneList.CopyEnabled"
         parameter="copy_all" />
    </menu_item_call>
    <menu_item_separator />
    <menu_item_call
     label="Select All"
     name="select_all">
        <menu_item_call.on_click
         function="PaneList.Copy"
         parameter="select_all" />
        <menu_item_call.on_enable
         function="PaneList.CopyEnabled"
         parameter="select_all" />
    </menu_item_call>
</context_menu>
