<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 legacy_header_height="18"
 can_resize="true"
 height="520"
 layout="topleft"
 min_height="360"
 min_width="390"
 name="scene_explorer"
 help_topic="scene_explorer"
 save_rect="true"
 single_instance="true"
 title="Scene Explorer"
 width="420">
    <filter_editor
     follows="left|top|right"
     height="22"
     layout="topleft"
     label="Filter by name, description or UUID"
     name="filter_input"
     text_pad_left="10"
     left="8"
     top="22"
     width="404" />
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     name="owner_combo"
     tool_tip="Filter by owner"
     left="8"
     top_pad="6"
     width="130">
        <combo_box.item label="Any owner" name="any" value="0" />
        <combo_box.item label="Owned by me" name="mine" value="1" />
        <combo_box.item label="Group owned" name="group" value="2" />
        <combo_box.item label="Owned by others" name="others" value="3" />
    </combo_box>
    <combo_box
     follows="top|right"
     height="22"
     layout="topleft"
     name="sort_combo"
     tool_tip="Sort order"
     left_pad="8"
     top_delta="0"
     width="130">
        <combo_box.item label="Sort: Distance" name="distance" value="0" />
        <combo_box.item label="Sort: Name" name="name" value="1" />
        <combo_box.item label="Sort: Land impact" name="li" value="2" />
        <combo_box.item label="Sort: Triangles" name="tris" value="3" />
        <combo_box.item label="Sort: Type" name="type" value="4" />
    </combo_box>
    <check_box
     follows="left|top"
     height="18"
     label="Scripted"
     layout="topleft"
     name="flag_scripted"
     left="8"
     top_pad="6"
     width="80" />
    <check_box
     follows="left|top"
     height="18"
     label="Light"
     layout="topleft"
     name="flag_light"
     left_pad="4"
     top_delta="0"
     width="60" />
    <check_box
     follows="left|top"
     height="18"
     label="Particles"
     layout="topleft"
     name="flag_particles"
     left_pad="4"
     top_delta="0"
     width="80" />
    <check_box
     follows="top|right"
     height="18"
     label="Avatars"
     layout="topleft"
     name="show_avatars_check"
     initial_value="true"
     left_pad="4"
     top_delta="0"
     width="80" />
    <check_box
     follows="left|top"
     height="18"
     label="Within"
     layout="topleft"
     name="limit_radius_check"
     left="8"
     top_pad="6"
     width="70" />
    <slider
     follows="left|top"
     height="18"
     decimal_digits="0"
     increment="1"
     initial_value="64"
     layout="topleft"
     max_val="512"
     min_val="8"
     name="radius_slider"
     tool_tip="Radius (m)"
     left_pad="2"
     top_delta="0"
     width="300" />
    <panel
     bevel_style="in"
     border="true"
     follows="all"
     layout="topleft"
     name="scene_tree"
     left="8"
     top_pad="6"
     width="404"
     height="356" />
    <button
     follows="bottom|left"
     height="23"
     label="Refresh"
     layout="topleft"
     name="refresh_btn"
     left="8"
     bottom="-8"
     width="64" />
    <button
     follows="bottom|left"
     height="23"
     label="Focus"
     layout="topleft"
     name="focus_btn"
     left_pad="2"
     bottom_delta="0"
     width="56" />
    <button
     follows="bottom|left"
     height="23"
     label="Edit"
     layout="topleft"
     name="edit_btn"
     left_pad="2"
     bottom_delta="0"
     width="50" />
    <button
     follows="bottom|left"
     height="23"
     label="Inspect"
     layout="topleft"
     name="inspect_btn"
     left_pad="2"
     bottom_delta="0"
     width="62" />
    <button
     follows="bottom|left"
     height="23"
     label="TP"
     layout="topleft"
     name="teleport_btn"
     left_pad="2"
     bottom_delta="0"
     width="42" />
    <button
     follows="bottom|left"
     height="23"
     label="Copy ID"
     layout="topleft"
     name="copy_id_btn"
     left_pad="2"
     bottom_delta="0"
     width="64" />
</floater>
