<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
    border="false"
    height="408"
    label="Text Chat"
    layout="topleft"
    left="102"
    name="preferences_chat_general"
    top="1"
    width="517">
    <panel
        border="false"
        height="60"
        layout="topleft"
        name="general_chat_settings" 
        top="10"
        left="13"
        width="517">
        <check_box
            control_name="ChatAutocompleteGestures"
            height="16"
            initial_value="true"
            label="Auto-complete gestures in nearby chat"
            layout="topleft"
            top_pad="3"
            name="auto_complete_gestures"
            width="330">
        </check_box>
        <check_box
            control_name="PlayTypingAnim"
            height="16"
            initial_value="true"
            label="Play typing animation when chatting"
            layout="topleft"
            top_pad="3"
            name="play_typing_animation"
            width="330">
        </check_box>

        <text
            font="SansSerifSmall"
            follows="left|top"
            height="18"
            layout="topleft"
            length="1"
            name="email_settings"
            skip_link_underline="true"
            top_pad="5"
            left_delta="5"
            type="string"
            width="350">
            [https://accounts.secondlife.com/change_email Email me IMs when I'm offline]
        </text>

        <text
            layout="topleft"
            left="389"
            height="12"
            name="font_size"
            width="80"
            top="0">
        Font size:
        </text>

        <combo_box
            control_name="ChatFontSize"
            height="23"
            layout="topleft"
            left="385"
            name="chat_font_size"
            top_pad="5"
            width="100">
        <item
            label="Monospace"
            name="Monospace"
            value="-1"/>
        <item
            label="Small"
            name="Small"
            value="0"/>
        <item
            label="Medium"
            name="Medium"
            value="1"/>
        <item
            label="Large"
            name="Large"
            value="2"/>
        <item
            label="Huge"
            name="Huge"
            value="3"/>
        </combo_box>

        <check_box
            control_name="UseChatBubbles"
            height="16"
            label="Bubble Chat"
            layout="topleft"
            top_pad="8"
            left_delta="-5"
            name="bubble_text_chat"
            width="330">
        </check_box>
        
    </panel>

    <panel
        border="false"
        height="110"
        layout="topleft"
        follows="left|top"
        name="contact_settings"
        left="13"
        top_pad="10"
        width="517">
        <text
            follows="left|top"
            height="14"
            layout="topleft"
            left="0"
            name="contact_label"
            top="0"
            width="300">
        Who can reach me:
        </text>
        <text
            follows="left|top"
            height="14"
            layout="topleft"
            left="0"
            name="contact_im_label"
            top_pad="10"
            width="120">
        Instant messages:
        </text>
        <combo_box
            control_name="SKContactIMs"
            follows="left|top"
            height="23"
            layout="topleft"
            left="125"
            name="contact_im_combo"
            top_delta="-4"
            width="115">
            <item label="Everyone" name="everyone" value="0"/>
            <item label="Friends only" name="friends" value="1"/>
        </combo_box>
        <text
            follows="left|top"
            height="14"
            layout="topleft"
            left="255"
            name="contact_group_chat_label"
            top_delta="4"
            width="120">
        Group chat:
        </text>
        <combo_box
            control_name="SKContactGroupChat"
            follows="left|top"
            height="23"
            layout="topleft"
            left="365"
            name="contact_group_chat_combo"
            top_delta="-4"
            width="110">
            <item label="Everyone" name="everyone" value="0"/>
            <item label="Nobody" name="nobody" value="2"/>
        </combo_box>
        <text
            follows="left|top"
            height="14"
            layout="topleft"
            left="0"
            name="contact_call_label"
            top_pad="8"
            width="120">
        Voice calls:
        </text>
        <combo_box
            control_name="SKContactCalls"
            follows="left|top"
            height="23"
            layout="topleft"
            left="125"
            name="contact_call_combo"
            top_delta="-4"
            width="115">
            <item label="Everyone" name="everyone" value="0"/>
            <item label="Friends only" name="friends" value="1"/>
            <item label="Nobody" name="nobody" value="2"/>
        </combo_box>
        <text
            follows="left|top"
            height="14"
            layout="topleft"
            left="255"
            name="contact_group_call_label"
            top_delta="4"
            width="120">
        Group voice calls:
        </text>
        <combo_box
            control_name="SKContactGroupCalls"
            follows="left|top"
            height="23"
            layout="topleft"
            left="365"
            name="contact_group_call_combo"
            top_delta="-4"
            width="110">
            <item label="Everyone" name="everyone" value="0"/>
            <item label="Nobody" name="nobody" value="2"/>
        </combo_box>
        <text
            follows="left|top"
            height="14"
            layout="topleft"
            left="0"
            name="contact_conference_label"
            top_pad="8"
            width="120">
        Conferences:
        </text>
        <combo_box
            control_name="AlchemyIgnoreAdHocSessions"
            follows="left|top"
            height="23"
            layout="topleft"
            left="125"
            name="contact_conference_combo"
            top_delta="-4"
            width="115">
            <item label="Everyone" name="everyone" value="0"/>
            <item label="Friends only" name="friends" value="1"/>
            <item label="Nobody" name="nobody" value="2"/>
        </combo_box>
    </panel>

    <panel
        height="50"
        layout="topleft"
        name="log_settings" 	
        left="13"
        top_pad="10"
        width="505">

        <text
            name="logging_label"
            layout="topleft"
            left="0"
            text_color="White"
            height="12"
            top="5"
            width="55">
            Save:
        </text>

        <combo_box
            enabled="false"
            control_name="KeepConversationLogTranscripts"
            height="23"
            layout="topleft"
            left_pad="5"
            name="conversation_log_combo"
            top="0"
            width="165">
            <item
                name="log_and_transcripts"
                label="Log and transcripts"
                value="2"/>
            <item
                name="log_only"
                label="Log only"
                value="1"/>
            <item
                name="no_log_or_transcript"
                label="No log or transcripts"
                value="0"/>
        </combo_box>

        <button
            enabled="false"
            height="23"
            label="Clear log..."
            layout="topleft"
            left_pad="5"
            top="0"
            name="clear_log"
            width="110">
            <commit_callback
                function="Pref.ClearLog" />
        </button>
    
        <button
            enabled="false"
            height="23"
            label="Delete transcripts..."
            layout="topleft"
            left_pad="5"
            top="0"
            name="delete_transcripts"
            width="147">
            <button.commit_callback
                function="Pref.DeleteTranscripts" />
        </button>
    
        <text
            name="log_location_label"
            layout="topleft"
            left="0"
            text_color="White"
            height="12"
            top_pad="15"
            width="55">
            Location:
        </text>
    
        <line_editor
            control_name="InstantMessageLogPath"
            border_style="line"
            border_thickness="1"
            font="SansSerif"
            height="23"
            layout="topleft"
            left_pad="55"
            max_length_bytes="4096"
            name="log_path_string"
            top_delta="-5"
            width="185">
        </line_editor>
    
        <button
            enabled="false"
            follows="left|top"
            height="23"
            label="Browse..."
            label_selected="Browse"
            layout="topleft"
            left_pad="5"
            name="log_path_button"
            top_delta="0"
            width="112">
        <commit_callback function="Pref.LogPath" />
        </button>
    </panel>
    <button
        height="23"
        label="Translation..."
        layout="topleft"
        left="9"
        name="ok_btn"
        top="-29"
        width="170">
        <commit_callback
            function="Pref.TranslationSettings" />
    </button>
    <button
        height="23"
        layout="topleft"
        top_pad="-23"
        left_pad="5"
        name="autoreplace_showgui"
        commit_callback.function="Pref.AutoReplace"
        label="Auto-Replace..."
        width="150">
    </button>
    <button
        height="23"
        layout="topleft"
        top_pad="-23"
        left_pad="5"
        name="spellcheck_showgui"
        commit_callback.function="Pref.SpellChecker"
        label="Spell Checking..."
        width="150">
    </button>
</panel>
