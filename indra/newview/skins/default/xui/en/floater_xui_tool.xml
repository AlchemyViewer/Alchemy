    <floater.string name="ExternalEditorNotSet">No editor: set the ExternalEditor setting or the LL_XUI_EDITOR environment variable, with %s for the file and %L for the line.</floater.string>
    <floater.string name="NoFile">Select a file.</floater.string>
    <floater.string name="NotBuilt">This kind of file is catalogued and searched, not built.</floater.string>
    <floater.string name="ViewerWidget">[TAG] is a viewer widget: a shell build does not run its constructor. Catalogued and searched.</floater.string>
    <floater.string name="Built">[VIEWS] views in [MS] ms, [DIAG] findings, [SKIN]/[LANG]</floater.string>
    <floater.string name="BuildFailed">Could not build [FILE]: see the findings.</floater.string>
    <floater.string name="Reloaded">Reloaded after a change on disk.</floater.string>
    <floater.string name="NoResults">No matches.</floater.string>
    <floater.string name="EditTarget">Moves write to [FILE] in [LAYER]</floater.string>
    <floater.string name="EditNoTarget">Select an element to move it.</floater.string>
    <floater.string name="EditNoSelection">Nothing is selected.</floater.string>
    <floater.string name="EditWrote">Wrote [ATTRS] to [FILE] in [LAYER]</floater.string>
    <floater.string name="EditWroteNotMoved">Wrote [ATTRS] to [FILE] in [LAYER]; the preview's own frame is placed here, not by the file</floater.string>
    <floater.string name="EditRootMove">The preview's own frame is placed here, not by the file: its size is editable, its position is not.</floater.string>
    <floater.string name="EditUndone">Put [FILE] back the way it was.</floater.string>
    <floater.string name="TranslateCounts">[TRANSLATED] translated, [MISSING] missing, [NOTAPPLIED] applying to nothing, [PLACEHOLDERS] stale, [FORBIDDEN] forbidden</floater.string>
    <floater.string name="TranslateNoFile">Select a file and a language.</floater.string>
    <floater.string name="TranslateWrote">Wrote [FIELD] into [FILE]</floater.string>
    <floater.string name="TranslateRepaired">Moved [MOVES] values into place in [FILE]</floater.string>
    <floater.string name="TranslateRepairedAll">Moved [MOVES] values into place across [FILES] files in [LANG]</floater.string>
    <floater.string name="TranslateNothingToRepair">Nothing in [FILE] is written at a path the base has moved on from.</floater.string>
    <floater.string name="TranslateSameLanguage">Choose a language other than the base to translate into.</floater.string>
    <floater.string name="TranslateRoots">Gave [FILES] files in [LANG] the base's root name; [LEFT] left alone as translations of something else</floater.string>
    <floater.string name="CensusStarted">Counting what every language's overlay does...</floater.string>
    <floater.string name="CensusProgress">Counted [DONE] of [TOTAL] files</floater.string>
    <floater.string name="CensusDone">[COVERED] values arrive, [NOTHING] apply to nothing; table written to [FILE]</floater.string>
