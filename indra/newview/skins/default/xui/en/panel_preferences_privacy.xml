<?xml version="1.0" encoding="utf-8" standalone="yes"?>
  <panel
    border="true"
    follows="left|top|right|bottom"
    height="438"
    label="Privacy"
    layout="topleft"
    left="102"
    name="Privacy panel"
    top="1"
    width="517">

  <!-- The full height: the General tab's page only just fits under the tab row. -->
  <tab_container
    top_pad="0"
    enabled="true"
    follows="left|top"
    height="438"
    width="517"
    left_delta="0"
    name="privacy_tab_container"
    tab_position="top"
    tab_stop="false">
  <panel
    label="General"
    name="privacy_preferences_general"
    layout="topleft"
    follows="top|left">

  <panel.string
      name="log_in_to_change">
    log in to change
  </panel.string>

  <button
      follows="left|top"
      height="23"
      label="Clear History"
      tool_tip="Clear search and teleport history, web and texture cache"
      layout="topleft"
      left="30"
      name="clear_cache"
      top="10"
      width="145">
    <button.commit_callback
        function="Pref.WebClearCache" />
  </button>

  <text
      type="string"
      length="1"
      follows="left|top"
      height="10"
      layout="topleft"
      left_pad="10"
      mouse_opaque="false"
      name="cache_size_label_l"
      top_delta="3"
      text_color="LtGray_50"
      width="300">
    (Locations, images, web, search history)
  </text>

  <check_box
      height="16"
      enabled="false"
      label="Show my profile info in Search results"
      layout="topleft"
      left="30"
      name="online_searchresults"
      top_pad="20"
      width="350" />

  <check_box
      height="16"
      enabled="false"
      label="Only friends and groups know I'm online"
      layout="topleft"
      left="30"
      name="online_visibility"
      top_pad="15"
      width="350" />

    <check_box
     enabled_control="EnableVoiceChat"
     control_name="AutoDisengageMic"
     height="16"
     label="Switch off microphone when ending calls"
     layout="topleft"
     left="30"
     name="auto_disengage_mic_check"
     top_pad="5"
     width="350" />
    <check_box
     control_name="EnableSelectionHints"
     height="16"
     label="Show my selection beam and particle swirls"
     tool_tip="Enable reporting and tracking current selection using 'beam' particles and character animations"
     layout="topleft"
     left="30"
     name="enable_selection_hints"
     top_pad="5"
     width="350" />
    <check_box
     height="16"
     label="Send crash reports to the Alchemy developers"
     tool_tip="A report carries where the viewer crashed, its log, your settings and your avatar name, and goes to Sentry, where only the Alchemy developers can see it"
     layout="topleft"
     left="30"
     name="crash_reports_check"
     top_pad="5"
     width="350" />
        <text
         type="string"
         length="1"
         follows="left|top"
         height="20"
         layout="topleft"
         left="20"
         top_pad="0"
         name="mylookat"
         valign="center"
         width="200">
            Look At:
        </text>
        <check_box
         follows="left|top"
         height="16"
         label="Show others Look At targets"
         left="30"
         name="showlookat"
         width="250"
         control_name="AlchemyLookAtShow"
         tool_tip="Enable crosshairs marking where people are looking."/>
        <text
         type="string"
         length="1"
         follows="left|top"
         height="15"
         layout="topleft"
         left="290"
         name="lookatnames"
		     tool_tip="Select whether to show avatar names on the LookAt crosshairs"
         left_delta="250"
         width="70">
            Name Style:
        </text>
        <combo_box
         control_name="AlchemyLookAtNames"
         follows="left|top"
         height="23"
         layout="topleft"
         top_delta="-4"
         left_pad="0"
         max_chars="135"
         name="lookatshownames_combobox"
         width="150">
            <combo_box.item
             enabled="true"
             label="None"
             name="None"
             value="0" />
            <combo_box.item
             enabled="true"
             label="Complete name"
             name="Complete_Name"
             value="1" />
            <combo_box.item
             enabled="true"
             label="Display name"
             name="Display_Name"
             value="2" />
            <combo_box.item
             enabled="true"
             label="Legacy name"
             name="Legacy_Name"
             value="3" />
            <combo_box.item
             enabled="true"
             label="Username"
             name="User_Name"
             value="4" />
        </combo_box>

        <check_box
         control_name="AlchemyLookAtLines"
         height="16"
         label="Show a line from the Look At beacon to its owner"
         layout="topleft"
         left="30"
         name="lineslookat"
         tool_tip="See a line connecting the camera focus point to the avatar. Useful to find where they are."
         top_pad="0"
         width="350" />
      <text
         type="string"
         length="1"
         follows="left|top"
         height="20"
         layout="topleft"
         left="20"
         name="inventory_header"
         width="200"
         top_pad="8"
         valign="center"
         text_color="LtGray_50">
         Inventory:
      </text>
      <check_box
         control_name="AutoAcceptNewInventory"
         height="16"
         label="Automatically accept new inventory items"
         layout="topleft"
         follows="left|top"
         name="Auto_Accept_New_Inventory"
         width="350"
         left="30"
         top_pad="4" />
      <check_box
         control_name="ShowInInventory"
         height="16"
         label="Automatically show newly accepted items in inventory"
         layout="topleft"
         follows="left|top"
         name="Show_In_Inventory"
         width="350"
         left="30"
         top_pad="4" />
      <check_box
         control_name="ShowNewInventory"
         height="16"
         label="Automatically view notecards, textures, landmarks after accepting"
         layout="topleft"
         follows="left|top"
         name="Show_New_Inventory"
         left="30"
         top_pad="4"
         width="350" />

        <text
         type="string"
         length="1"
         follows="left|top"
         height="14"
         layout="topleft"
         left="20"
         name="mylookat_label"
         top_pad="8"
         width="200">
            My LookAt:
        </text>
	    	<check_box
         control_name="AlchemyLookAtHideSelf"
         height="16"
         initial_value="true"
         label="Don't show me my Look At target"
         layout="topleft"
         left="30"
         name="LookAtHideOwn"
         tool_tip="Don't show me my own camera crosshairs"
         width="350" />
        <check_box
         control_name="EnableLookAtTarget"
         height="16"
         label="Don't send my Look At target to others"
         layout="topleft"
         left="30"
         name="privatelookat"
         tool_tip="Disable your camera focus point from showing to others"
         width="350" />
        <check_box
         control_name="LimitLookAtTarget"
         disabled_control="EnableLookAtTarget"
         height="16"
         label="Limit Look At Distance"
         layout="topleft"
         left="30"
         name="limitlookat"
         tool_tip="Allows cosmetic features like eye and head movement but will point at nothing specific if beyond the set distance."
         width="200" />
         <slider
            height="16"
            left_pad="10"
            top_delta="0"
            min_val="0.5"
            max_val="128"
            follows="top|left"
            control_name="LimitLookAtTargetDistance"
            disabled_control="EnableLookAtTarget"
            initial_value="1.0"
            increment="0.5"
            label="Max Distance"
            width="275"
            layout="topleft"/>
    <button
     follows="left|top"
     height="23"
     label="Block list"
     layout="topleft"
     left="30"
     name="block_list"
     top_pad="10"
     width="145">
        <!--<button.commit_callback
         function="SideTray.ShowPanel"-->
      <button.commit_callback
         function="Pref.BlockList"/>
    </button>
    <text
     type="string"
     length="1"
     follows="left|top"
     height="10"
     layout="topleft"
     left_pad="10"
     mouse_opaque="false"
     name="block_list_label"
     top_delta="3"
     text_color="LtGray_50"
     width="300">
       (People and/or Objects you have blocked)
    </text>
    </panel>

    <panel
      label="Discord"
      name="privacy_preferences_discord"
      layout="topleft"
      follows="top|left">

      <!-- The account's settings: enabled once logged in. -->
      <check_box
        control_name="ALDiscordIntegration"
        height="16"
        enabled="false"
        label="Show my activity on Discord"
        layout="topleft"
        left="30"
        name="enable_discord"
        tool_tip="Your Discord friends see the grid, the viewer and your time online; your name and location only as chosen below, and never while RLV hides them. Log in to change these."
        top="20"
        width="450" />

      <check_box
        control_name="ALDiscordShareName"
        enabled_control="ALDiscordIntegration"
        height="16"
        enabled="false"
        label="Show my avatar name"
        layout="topleft"
        left="50"
        name="show_name"
        top_pad="10"
        width="400" />

      <check_box
        control_name="ALDiscordShareLocationRegion"
        enabled_control="ALDiscordIntegration"
        height="16"
        enabled="false"
        label="Show my region and position"
        layout="topleft"
        left="50"
        name="show_location"
        tool_tip="The region name and your position, in regions up to the rating below. Not sent while RLV hides your location."
        top_pad="10"
        width="400" />

      <text
        type="string"
        length="1"
        follows="left|top"
        height="16"
        layout="topleft"
        left="70"
        name="discord_max_maturity_label"
        top_pad="10"
        width="180">
        In regions rated:
      </text>
      <combo_box
        control_name="ALDiscordShareRegionMaxMaturity"
        enabled_control="ALDiscordIntegration"
        enabled="false"
        follows="left|top"
        height="23"
        layout="topleft"
        left_pad="5"
        name="discord_max_maturity"
        top_delta="-4"
        width="200">
        <combo_box.item
          label="General"
          name="discord_maturity_general"
          value="13" />
        <combo_box.item
          label="General and Moderate"
          name="discord_maturity_moderate"
          value="21" />
        <combo_box.item
          label="General, Moderate and Adult"
          name="discord_maturity_adult"
          value="42" />
      </combo_box>

      <text
        type="string"
        length="1"
        follows="left|top"
        height="16"
        layout="topleft"
        left="30"
        name="discord_note"
        text_color="LtGray_50"
        top_pad="16"
        width="450"
        wrap="true">
        Needs the Discord app running.
      </text>
    </panel>
  </tab_container>

</panel>
