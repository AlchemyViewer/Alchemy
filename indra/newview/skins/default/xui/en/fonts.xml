<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  ==========================================================================
  fonts.xml — UI font registry
  ==========================================================================

  Skins layer additively: every skin's fonts.xml is parsed, and a later
  skin's <font name="X"> entry PREPENDS its files to whatever the earlier
  skin already had. <use> and inherit="true" are resolved ONCE after every
  layer has been read. This file is the default skin, so it sets the
  baseline registry every other skin's overrides extend.

  ==========================================================================
  Top-level elements (children of <fonts>)
  ==========================================================================
  <font>           Defines a font family (e.g. "SansSerif", "Monospace").
  <font_size>      Adds a name -> point-size mapping to the global table
                   (e.g. <font_size name="Huge" size="16.0"/>). Per-family
                   <size> children inside <font> take precedence.

  ==========================================================================
  <font> attributes
  ==========================================================================
  name              REQUIRED. Family name. Widget XUI references it via
                    font="Name" or font.size="Name". Sizes are appended
                    (SansSerifLarge -> family "SansSerif" + size "Large").
  label          Human-friendly label shown in font-picker dropdowns.
                    Defaults to `name` if absent.
  user_selectable   true/false. When false, the family is hidden from the
                    font picker (used for internal fallbacks like Emoji,
                    CJK, Helvetica). Default true.
  monospace         true/false. Marks the family as fixed-width. Picker
                    routes it to the Monospace category and the renderer
                    bypasses HarfBuzz GPOS so column alignment holds.
                    Default false.
  emoji             true/false. Marks the family as a color-emoji
                    source font (e.g. Noto-COLRv1, Twemoji). Picker
                    routes it to a separate "Emoji Font" category via
                    getAvailableFamilies(FamilyFilter::EMOJI). Emoji
                    families are excluded from the regular UI/Mono
                    pickers (PROPORTIONAL and MONOSPACE filter them
                    out) so a color emoji file doesn't surface as a
                    selectable text font. Default false.
  ligatures         on/true/1 keeps liga/clig/dlig/calt features enabled
                    even on monospace faces. For programmer fonts (Fira
                    Code, JetBrains Mono) where ligatures are width-
                    preserving by design. Default off. Inherited by every
                    <file> in this family unless the file overrides it.
  font_hinting      Family-level default. One of:
                      default       — FreeType's default hinter
                      force_auto    — autohinter (DEFAULT)
                      no_hinting    — outlines passed unhinted
                      light         — light autohint (vertical only),
                                      pairs with subpixel pen for smooth,
                                      weight-stable text. Slightly softer
                                      stems than force_auto.
                    Each <file> can override.
  font_weight       Family-level default variable-font weight axis. Each
                    <file> can override. -1 means use the file's own
                    default. Typical values: 400 (regular), 600 (bold).
                    OpenType `wght` axis (1..1000 design coords).
  font_optical_size F32. Family-level OpenType `opsz` axis. Variable
                    fonts only. When absent, opsz defaults to the
                    rendered point size (Inter benefits from this so
                    small/large renders pick up the design's optical
                    adjustment automatically). Explicit values pin
                    opsz to one design size regardless of pt. Each
                    <file> can override.
  font_italic       F32. Family-level OpenType `ital` axis. Variable
                    fonts only. 0 = upright, 1 = italic. Distinct from
                    the binary <style name="ITALIC"> file slot — `ital`
                    smoothly interpolates within a single variable face.
                    Each <file> can override.
  font_width        F32. Family-level OpenType `wdth` axis. Variable
                    fonts only. Percent of normal width (50..200; 100
                    = unchanged). Each <file> can override.
  font_slant        F32. Family-level OpenType `slnt` axis. Variable
                    fonts only. Degrees (-90..0; 0 upright, negative
                    slants forward). Distinct from font_italic — many
                    fonts expose only one of the two; check the
                    foundry's docs. Each <file> can override.
  comment           Free-form. Parser ignores. Use for documentation.

  ==========================================================================
  <font> children
  ==========================================================================
  <size name=".." size=".."/>
                    Per-family size pin. THIS family's files render at
                    this point size whenever they appear in any chain —
                    head OR fallback — regardless of what point size
                    the surrounding chain asks for. size_delta on
                    individual <file> entries still adds on top.

                    Lookup priority for nameToSize(family, name):
                      1. `family`'s own <size> table.
                      2. Global <font_size> table.

                    No cross-family propagation: per-family <size> does
                    NOT flow through <use> chains, and
                    AlchemyUIFontOverrides only changes file lists, not
                    the override target's resolved point size. Each file
                    in a chain looks up its own source family's <size>
                    at render time; non-pinned files render at the chain
                    head's resolved pt.
  <use family="OtherFamily"/>
                    Append OtherFamily's matching-style files to this
                    family's chain, then recursively walk OtherFamily's
                    own <use> chain. Each level matches the requested
                    style first and falls back to that family's NORMAL
                    if absent. Cycles (A->B->A) and diamonds (A->B,
                    A->C with both B and C using D) terminate cleanly
                    with each family contributing files exactly once.
                    Self-references and unknown direct families log a
                    warning and are skipped. Lets you compose chains
                    (e.g. a "ScriptFallbacks" family that <use>s
                    DejaVu/Emoji/CJK; user-facing families just <use>
                    "ScriptFallbacks").
  <use family="OtherFamily" unicode_ranges="..."/>
                    Optional `unicode_ranges` attribute: gates the
                    files contributed by OtherFamily to the listed
                    codepoint ranges (same syntax as <file>'s own
                    unicode_ranges). Composes (intersects) with each
                    contributed file's existing range filter. Lets a
                    single source family be `<use>`d by multiple
                    consumers each applying their own filter at the
                    use site (e.g. EmojiBase shared between Emoji's
                    broad UTS#51 set and LimitedEmoji's narrower set
                    without duplicating the file). The filter applies
                    only to OtherFamily's own files — it does NOT
                    cascade through OtherFamily's internal <use>
                    chain.
  <style name="..">
                    Style variant block. `name` is one of NORMAL, BOLD,
                    ITALIC, BOLD|ITALIC. Anything else maps to NORMAL.

  ==========================================================================
  <style> attributes
  ==========================================================================
  name              REQUIRED. NORMAL | BOLD | ITALIC | BOLD|ITALIC.
  inherit           true/false. On a non-NORMAL style, append this
                    family's NORMAL-style resolved files (post-<use>) to
                    this style's chain. Default false. Useful so BOLD
                    only needs to declare its bold face — fallbacks are
                    inherited from NORMAL automatically.

  ==========================================================================
  <file> attributes (text content is the font filename)
  ==========================================================================
  font_hinting      Override family-level setting. Values as above.
  font_weight       Override family-level weight. Variable fonts only;
                    static fonts ignore this. See <font> attrs above
                    for value range.
  font_optical_size Override family-level opsz. See <font> attrs above.
  font_italic       Override family-level ital. See <font> attrs above.
  font_width        Override family-level wdth. See <font> attrs above.
  font_slant        Override family-level slnt. See <font> attrs above.
  flags             Comma-separated style flags forced on this file's
                    glyphs. Currently only "bold" is recognized — used
                    when a single .woff2 carries both upright & italic
                    OR weights, and you want the "BOLD" face to also
                    set the BOLD style flag for callers checking it.
  size_delta        F32 added to the requested point size for this file.
                    Used to align the visual x-height across files in a
                    chain that disagree on intrinsic size. Negative
                    values shrink, positive grow. Default 0.
  unicode_ranges    Comma-separated list of Unicode ranges this file is
                    allowed to handle. Format:
                      "U+1F600"                  single codepoint
                      "U+1F000-U+1FFFF"          range
                      "U+2600-U+27BF,U+1F000-U+1FFFF"   multiple
                    Codepoints outside every listed range skip this
                    file during fallback walks. Hex digits are case-
                    insensitive; "0xXXXX" is also accepted. Default:
                    handle all codepoints.

                    See also `<use unicode_ranges="...">` (in <font>
                    children docs above) for applying the same gate at
                    the use site instead of on the file itself — useful
                    when one source family is shared by multiple
                    consumers each wanting their own filter without
                    duplicating the file reference.

  ==========================================================================
  <file> path resolution
  ==========================================================================
  Filenames are searched in this order:
    1. <viewer install dir>/fonts/         (bundled fonts)
    2. OS system font directory            (C:\Windows\Fonts, ~/Library/Fonts, etc.)
    3. macOS Library + Library/Supplemental
  Collections (.ttc / .otc) are auto-detected — every face in the file
  is loaded as its own fallback entry; no flag is needed.

  ==========================================================================
  <os name="Windows|Mac|Linux">
  ==========================================================================
  Wrap <file> entries that should only load on a specific OS. Recurses
  during parse and only the matching block contributes files to the
  chain.

  ==========================================================================
  Implicit "default" font
  ==========================================================================
  The family named "default" is automatically appended to EVERY other
  family's chain inside createFont. It exists for ultimate OS fallbacks
  (system Arial, CJK system fonts). Don't <use> it directly — every
  family already inherits it.

  ==========================================================================
  Runtime overrides (debug settings)
  ==========================================================================
  AlchemyUIFontOverrides is an LLSD map that prepends a different
  source onto a family's chain at runtime. The override value can be:
    - Another family name (e.g. "SourceSans")  ->  pulls that family's
      files in front of the target. Per-family <size> lookups also
      route through the source so the visual scale follows.
    - A bare font filename (e.g. "consola.ttf")  ->  prepended as a
      single file with the target family's hinting/weight/flags
      inherited from its first existing file.

  Each entry's value can take one of two LLSD shapes:
    - Flat string (user-facing default)  ->  the override value is
      prepended in front of the target's chain; the original head
      stays as a fallback for glyphs the override doesn't cover. This
      is the shape the Preferences font picker writes.
    - Map { "value": "...", "replace_first": true }  ->  same as
      above, but DROPS the target's head file before prepending. The
      rest of the target's chain (DejaVu/Emoji/CJK fallbacks) stays.
      Non-user-facing — programmatic callers only; the picker keeps
      writing the flat-string shape. Use when you want the override
      to fully displace the original primary face rather than sit
      in front of it.

  Single-touchpoint emoji swap: the `EmojiBase` family is the
  registry's single source-of-truth for the color emoji file. Both
  `Emoji` (broad UTS#51 set) and `LimitedEmoji` (narrow UI-chrome set)
  are aliases that <use> EmojiBase with their respective filters at
  the use site. Setting AlchemyUIFontOverrides["EmojiBase"] = "..."
  therefore propagates to every emoji consumer in one entry, with
  each consumer's filter intact. Combine with replace_first=true to
  fully displace Noto-COLRv1 rather than sit in front of it. Prefer
  this over overriding `Emoji` / `LimitedEmoji` directly, since those
  paths only affect their own consumers (SansSerifEmoji,
  SansSerifLimitedEmoji) and not the Monospace/SansSerif chains.

  ==========================================================================
  Cross-script fallback families
  ==========================================================================
  The user-facing families (SansSerif, Monospace, Helvetica) keep their
  primary face minimal and pull script fallbacks (DejaVu for extended
  Latin, Emoji for pictographs, CJK for Han/Kana/Hangul) via <use>.
  Edit a single <use> chain to swap out a script's coverage for every
  user-facing family at once.
-->
<fonts>

  <!-- ========================================================== -->
  <!-- Cross-script fallback families.                              -->
  <!-- Small, single-purpose; pulled in by other families via <use>. -->
  <!-- user_selectable="false" hides them from the font-picker.     -->
  <!-- ========================================================== -->

    <font name="CascadiaCode" label="Cascadia Code" monospace="true" ligatures="true" font_hinting="light">
        <style name="NORMAL">
            <file font_weight="400">CascadiaCodeNF.ttf</file>
        </style>
        <style name="BOLD" inherit="true">
            <file flags="bold" font_weight="700">CascadiaCodeNF.ttf</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file font_weight="400">CascadiaCodeNF-Italic.ttf</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file flags="bold" font_weight="700">CascadiaCodeNF-Italic.ttf</file>
        </style>
    </font>

    <font name="DejaVu" label="DejaVu Sans" font_hinting="light">
        <!-- Per-family size overrides: DejaVu reads larger than the
             other Sans fonts at the same nominal pt, so map each named
             size to a smaller point value to keep visual parity. -->
        <size name="Huge"   size="16.0"/>
        <size name="Large"  size="10.6"/>
        <size name="Medium" size="8.6"/>
        <size name="Small"  size="7.6"/>

        <style name="NORMAL">
            <file>DejaVuSans.woff2</file>
        </style>
        <style name="BOLD" inherit="true">
            <file>DejaVuSans-Bold.woff2</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file>DejaVuSans-Oblique.woff2</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file>DejaVuSans-BoldOblique.woff2</file>
        </style>
    </font>

    <font name="DejaVuMono" label="DejaVu Sans Mono" monospace="true">
        <size name="Monospace" size="8.0"/>
        <size name="SmallLSL"  size="7"/>
        <size name="HugeLSL"   size="12"/>

        <style name="NORMAL">
            <file>DejaVuSansMono.woff2</file>
        </style>
    </font>

    <font name="IBMPlexSans" label="IBM Plex Sans" font_hinting="light">
        <style name="NORMAL">
            <file font_weight="400">IBMPlexSansVar-Roman.ttf</file>
        </style>
        <style name="BOLD" inherit="true">
            <file flags="bold" font_weight="700">IBMPlexSansVar-Roman.ttf</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file font_weight="400">IBMPlexSansVar-Italic.ttf</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file flags="bold" font_weight="700">IBMPlexSansVar-Italic.ttf</file>
        </style>
    </font>

    <font name="IBMPlexMono" label="IBM Plex Mono" font_hinting="light" monospace="true">
        <style name="NORMAL">
            <file>IBMPlexMono-Bold.ttf</file>
        </style>
        <style name="BOLD" inherit="true">
            <file>DejaVuSans-Bold.woff2</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file>IBMPlexMono-Italic.ttf</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file>IBMPlexMono-BoldItalic.ttf</file>
        </style>
    </font>

    <font name="Inter" label="Inter" font_hinting="light">
        <style name="NORMAL">
            <file font_weight="400">InterVariable.woff2</file>
        </style>
        <style name="BOLD" inherit="true">
            <file flags="bold" font_weight="700">InterVariable.woff2</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file font_weight="400">InterVariable-Italic.woff2</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file flags="bold" font_weight="700">InterVariable-Italic.woff2</file>
        </style>
    </font>

    <font name="OpenDyslexic" label="Open Dyslexic" font_hinting="default">
        <size name="Huge"   size="14.0"/>
        <size name="Large"  size="9.6"/>
        <size name="Medium" size="8.6"/>
        <size name="Small"  size="7.6"/>
        <style name="NORMAL">
            <file>OpenDyslexic-Regular.otf</file>
        </style>
        <style name="BOLD" inherit="true">
            <file>OpenDyslexic-Bold.otf</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file>OpenDyslexic-Italic.otf</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file>OpenDyslexic-BoldItalic.otf</file>
        </style>
    </font>

    <font name="SourceCode" label="Source Code Pro" monospace="true" font_hinting="light">
        <style name="NORMAL">
            <file font_weight="400">SourceCodeVF-Upright.woff2</file>
        </style>
        <style name="BOLD" inherit="true">
            <file flags="bold" font_weight="700">SourceCodeVF-Upright.woff2</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file font_weight="400">SourceCodeVF-Italic.woff2</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file flags="bold" font_weight="700">SourceCodeVF-Italic.woff2</file>
        </style>
    </font>

    <font name="SourceSans" label="Source Sans 3" font_hinting="light">
        <style name="NORMAL">
            <file font_weight="400">SourceSans3VF-Upright.woff2</file>
        </style>
        <style name="BOLD" inherit="true">
            <file flags="bold" font_weight="700">SourceSans3VF-Upright.woff2</file>
        </style>
        <style name="ITALIC" inherit="true">
            <file font_weight="400">SourceSans3VF-Italic.woff2</file>
        </style>
        <style name="BOLD|ITALIC" inherit="true">
            <file flags="bold" font_weight="700">SourceSans3VF-Italic.woff2</file>
        </style>
    </font>

    <font name="CJK" user_selectable="false" font_hinting="light">
        <!-- TTC collection — every face in the file auto-loads as a
             fallback entry, so a single <file> covers all weights/widths
             SourceHanSans ships. -->
        <style name="NORMAL">
            <file load_collection="true" font_weight="400">SourceHanSans-VF.otf.ttc</file>
        </style>
        <style name="BOLD">
            <file load_collection="true" flags="bold" font_weight="700">SourceHanSans-VF.otf.ttc</file>
        </style>
     </font>

    <font name="NotoEmoji" label="Noto Emoji" emoji="true">
        <size name="Huge"      size="16.0"/>
        <size name="Large"     size="13.0"/>
        <size name="Medium"    size="12"/>
        <size name="Small"     size="11"/>
        <size name="Monospace" size="11"/>
        <style name="NORMAL">
            <file>Noto-COLRv1.ttf</file>
        </style>
    </font>

    <font name="Twemoji" label="Twemoji" emoji="true">
        <size name="Huge"      size="16.0"/>
        <size name="Large"     size="13.0"/>
        <size name="Medium"    size="12"/>
        <size name="Small"     size="11"/>
        <size name="Monospace" size="11"/>
        <style name="NORMAL">
            <file>TwemojiSVG.woff2</file>
        </style>
    </font>

    <!-- Single source-of-truth for the color emoji file. Consumers reach
         it via `<use family="EmojiBase" unicode_ranges="..."/>` so each
         consumer can pick its own glyph filter at the use site without
         duplicating the file reference. An AlchemyUIFontOverrides entry
         on `EmojiBase` propagates to every consumer (Emoji, LimitedEmoji,
         and any future variant) with the consumer's filter intact. -->
    <font name="EmojiBase" user_selectable="false">
        <use family="NotoEmoji"/>
    </font>

    <font name="Emoji" user_selectable="false">
        <!-- The unicode_ranges gate enumerates UTS#51 emoji codepoints
             so the shape-itemizer keeps a whole emoji cluster on this
             face. Codepoints outside the gate route off Noto-COLRv1 to
             the next fallback, fragmenting ZWJ chains across faces and
             breaking the GSUB ligature lookup (e.g. U+1F408 ZWJ U+2B1B
             → 🐈‍⬛ depends on U+2B1B staying on this face). The set
             below covers Emoji_Presentation + the BMP emoji codepoints
             scattered outside U+2600-U+27BF (big-square / star / arrow
             / watch / hourglass / etc. emoji that pair with astral
             bases via ZWJ), plus the keycap combiner range, ZWJ, and
             VS-15 / VS-16 so emoji presentation selectors and joiners
             stay clustered. Rasterized via the in-tree COLRv1 paint
             walker (HarfBuzz callbacks -> plutovg). -->
        <use family="EmojiBase" unicode_ranges="U+200D,U+203C,U+2049,U+2122,U+2139,U+2194-U+2199,U+21A9-U+21AA,U+231A-U+231B,U+2328,U+23CF,U+23E9-U+23F3,U+23F8-U+23FA,U+24C2,U+25AA-U+25AB,U+25B6,U+25C0,U+25FB-U+25FE,U+2600-U+27BF,U+2934-U+2935,U+2B05-U+2B07,U+2B1B-U+2B1C,U+2B50,U+2B55,U+3030,U+303D,U+3297,U+3299,U+20E0-U+20E9,U+FE0E-U+FE0F,U+1F000-U+1FFFF"/>
    </font>

    <font name="LimitedEmoji" user_selectable="false">
        <!-- Narrower than Emoji's range — limited to "obviously
             emoji" codepoints for menu chrome and similar UI
             surfaces where wide BMP-pictograph coverage would
             collide with text styling. Includes the same cluster-
             helper codepoints as Emoji (ZWJ, VS-15/16, keycap
             combiner U+20E0-U+20E9) so multi-codepoint sequences
             anchored on astral bases (keycaps, ZWJ families) keep
             their trailing modifiers on this face — without these,
             "#️⃣" routes the keycap mark off to root and renders
             a tofu next to the digit. -->
        <use family="EmojiBase" unicode_ranges="U+200D,U+20E0-U+20E9,U+2B1B-U+2B1C,U+2B50,U+2B55,U+FE0E-U+FE0F,U+1F000-U+1FFFF"/>
    </font>

    <!-- The "default" font is appended (style-agnostically) to every
       font's chain inside createFont(). Keep it minimal: OS-specific
       CJK fonts that the standalone CJK family can't fully substitute
       for. Don't <use> "default" elsewhere — every family already
       picks it up automatically. -->
  <font name="default" comment="Implicit ultimate fallback, OS-specific CJK">
    <style name="NORMAL">
      <os name="Windows">
        <file>arial.ttf</file>
        <file>meiryo.TTC</file>
        <file>MSGOTHIC.TTC</file>
        <file>gulim.ttc</file>
        <file>simhei.ttf</file>
        <file>ArialUni.ttf</file>
        <file>msyh.ttc</file>
        <file load_collection="true">Cambria.ttc</file>
        <file>malgun.ttf</file>
        <file>micross.ttf</file>
      </os>
      <os name="Mac">
        <file>Helvetica.dfont</file>
        <file>ヒラギノ角ゴシック W3.ttc</file>
        <file>ヒラギノ角ゴ Pro W3.otf</file>
        <file>ヒラギノ角ゴ ProN W3.otf</file>
        <file>ヒラギノ明朝 ProN W3.ttc</file>
        <file>AppleGothic.dfont</file>
        <file>AppleGothic.ttf</file>
        <file>AppleSDGothicNeo-Regular.otf</file>
        <file>AppleSDGothicNeo.ttc</file>
        <file>华文细黑.ttf</file>
        <file>PingFang.ttc</file>
        <file>STIXGeneral.otf</file>
        <file>Thonburi.ttc</file>
      </os>
    </style>
  </font>

  <!-- ========================================================== -->
  <!-- Primary user-facing families. Each declares its own primary  -->
  <!-- face per style and pulls in the shared ScriptFallbacks chain -->
  <!-- via <use>. The implicit "default" family is appended after.  -->
  <!-- ========================================================== -->
  <font name="SansSerifBase" label="Sans Serif (Default)">
    <use family="SourceSans"/>
  </font>

  <font name="SansSerif" user_selectable="false">
    <use family="SansSerifBase"/>
    <use family="DejaVu"/>
    <use family="Emoji"/>
    <use family="CJK"/>
  </font>

  <font name="SansSerifEmoji" user_selectable="false">
    <use family="Emoji"/>
    <use family="SansSerifBase"/>
    <use family="DejaVu"/>
    <use family="CJK"/>
  </font>

  <font name="SansSerifLimitedEmoji" user_selectable="false">
    <use family="SansSerifBase"/>
    <use family="DejaVu"/>
    <use family="LimitedEmoji"/>
    <use family="CJK"/>
  </font>

  <font name="Helvetica" label="Helvetica / Arial" user_selectable="false">
    <style name="NORMAL">
      <file font_hinting="light" font_weight="400">SourceSans3VF-Upright.woff2</file>
      <os name="Windows"><file>arial.ttf</file></os>
      <os name="Mac"><file>arial.ttf</file></os>
    </style>
    <style name="BOLD" inherit="true">
      <file flags="bold" font_hinting="light" font_weight="600">SourceSans3VF-Upright.woff2</file>
      <os name="Windows"><file>arialbd.ttf</file></os>
