<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="bulk_rename"
 positioning="centered"
 title="BULK RENAME"
 width="420"
 height="172"
 single_instance="true"
 can_minimize="false"
 can_resize="false"
 can_close="true">
    <text
     type="string"
     follows="left|top"
     height="16"
     layout="topleft"
     left="10"
     name="mode_label"
     top="13"
     width="70">
        Mode:
    </text>
    <combo_box
     follows="left|top"
     height="22"
     layout="topleft"
     left_pad="4"
     name="mode_combo"
     top_delta="-3"
     width="120">
        <combo_box.item label="Add Text" name="mode_add" value="add" />
        <combo_box.item label="Replace Text" name="mode_replace" value="replace" />
        <combo_box.item label="Format" name="mode_format" value="format" />
    </combo_box>
    <panel
     follows="left|top|right"
     height="23"
     layout="topleft"
     left="0"
     name="add_panel"
     top="40"
     visible="false"
     width="420">
        <text
         type="string"
         follows="left|top"
         height="16"
         layout="topleft"
         left="10"
         name="add_label"
         top="3"
         width="70">
            Text:
        </text>
        <line_editor
         follows="left|top|right"
         height="22"
         layout="topleft"
         left_pad="4"
         max_length_bytes="63"
         name="add_text"
         width="120"
         top_delta="-3" />
        <text
         type="string"
         follows="left|top"
         height="16"
         layout="topleft"
         left="210"
         name="position_label"
         top="3"
         width="70">
            Position:
        </text>
        <combo_box
         follows="left|top"
         height="22"
         layout="topleft"
         left_pad="4"
         name="position_combo"
         top_delta="-3"
         width="120">
            <combo_box.item label="Before" name="position_before" value="before" />
            <combo_box.item label="After" name="position_after" value="after" />
        </combo_box>
    </panel>
    <panel
     follows="left|top|right"
     height="23"
     layout="topleft"
     left="0"
     name="replace_panel"
     top="40"
     visible="false"
     width="420">
        <text
         type="string"
         follows="left|top"
         height="16"
         layout="topleft"
         left="10"
         name="replace_label"
         top="3"
         width="70">
            Replace:
        </text>
        <line_editor
         follows="left|top|right"
         height="22"
         layout="topleft"
         left_pad="4"
         max_length_bytes="63"
         name="replace_text"
         width="120"
         top_delta="-3" />
        <text
         type="string"
         follows="left|top"
         height="16"
         layout="topleft"
         left="210"
         name="with_label"
         top="3"
         width="70">
            With:
        </text>
        <line_editor
         follows="left|top|right"
         height="22"
         layout="topleft"
         left_pad="4"
         max_length_bytes="63"
         name="with_text"
         width="120"
         top_delta="-3" />
    </panel>
    <panel
     follows="left|top|right"
     height="53"
     layout="topleft"
     left="0"
     name="format_panel"
     top="40"
     visible="true"
     width="420">
        <text
         type="string"
         follows="left|top"
         height="16"
         layout="topleft"
         left="10"
         name="format_kind_label"
         top="3"
         width="70">
            Kind:
        </text>
        <combo_box
         follows="left|top|right"
         height="22"
         layout="topleft"
         left_pad="4"
         name="format_kind_combo"
         width="120"
         top_delta="-3">
            <combo_box.item label="Name &amp; Current Date" name="format_kind_date_current" value="date_current" />
            <combo_box.item label="Name &amp; Acquired Date" name="format_kind_date_acquired" value="date_acquired" />
            <combo_box.item label="Name &amp; Count" name="format_kind_count" value="count" />
            <combo_box.item label="Name &amp; Index" name="format_kind_index" value="index" />
            <combo_box.item label="Custom" name="format_kind_custom" value="custom" />
        </combo_box>
        <panel
         follows="left|top|right"
	      height="53"
	      layout="topleft"
	      left="210"
	      name="format_position_panel"
	      top="0"
	      visible="true"
	      width="210">
         <text
          type="string"
          follows="left|top"
          height="16"
          layout="topleft"
          left="0"
          name="format_position_label"
          top="3"
          width="70">
               Position:
         </text>
         <combo_box
          follows="left|top"
          height="22"
          layout="topleft"
          left_pad="4"
          name="format_position_combo"
          top_delta="-3"
          width="120">
             <combo_box.item label="Before" name="format_position_before" value="before" />
             <combo_box.item label="After" name="format_position_after" value="after" />
          </combo_box>
        </panel>
        <text
         type="string"
         follows="left|top"
         height="16"
         layout="topleft"
         left="10"
         name="format_label"
         top="31"
         width="70">
            Format:
        </text>
        <line_editor
         follows="left|top|right"
         height="22"
         layout="topleft"
         left_pad="4"
         max_length_bytes="63"
         name="format_text"
         width="120"
         top_delta="-3" />
        <panel
         follows="left|top|right"
         height="28"
         layout="topleft"
         left="210"
         name="format_date_panel"
         top="31"
         visible="false"
         width="210">
            <text
             type="string"
             follows="left|top"
             height="16"
             layout="topleft"
             left="0"
             name="date_format_label"
             top="0"
             width="70">
                Date:
            </text>
            <combo_box
             follows="left|top|right"
             height="22"
             layout="topleft"
             left_pad="4"
             name="date_format_combo"
             width="120"
             top_delta="-3">
                <combo_box.item label="YYYY-MM-DD" name="date_ymd" value="%Y-%m-%d" />
                <combo_box.item label="YYYYMMDD" name="date_ymd_compact" value="%Y%m%d" />
                <combo_box.item label="YYYY-MM-DD HH:MM" name="date_ymd_hm" value="%Y-%m-%d %H:%M" />
                <combo_box.item label="DD/MM/YYYY" name="date_dmy" value="%d/%m/%Y" />
                <combo_box.item label="MM/DD/YYYY" name="date_mdy" value="%m/%d/%Y" />
            </combo_box>
        </panel>
        <panel
         follows="left|top|right"
         height="28"
         layout="topleft"
         left="210"
         name="format_counter_panel"
         top="31"
         visible="true"
         width="210">
            <text
             type="string"
             follows="left|top"
             height="16"
             layout="topleft"
             left="0"
             name="counter_start_label"
             top="0"
             width="70">
                Start at:
            </text>
            <spinner
             follows="left|top"
             height="22"
             increment="1"
             initial_value="1"
             decimal_digits="0"
             layout="topleft"
             left_pad="4"
             max_val="999999"
             min_val="0"
             name="counter_start"
             top_delta="-3"
             width="120" />
        </panel>
        <panel
         follows="left|top|right"
         height="28"
         layout="topleft"
         left="210"
         name="format_custom_panel"
         top="3"
         visible="true"
         width="210">
           <text
            type="string"
            follows="left|top"
            height="16"
            layout="topleft"
            left="30"
            name="custom_format_label"
            top="0"
            text_color="EmphasisColor"
            tool_tip="$n = original name&#10;$i = index (1, 2, 10)&#10;$c = padded count (01, 02, 10)&#10;$a = acquired date (YYYY-MM-DD)&#10;$t = acquired time (HH:MM:SS)&#10;&#10;strftime codes use the current time, e.g. %Y %m %d %H %M %S.&#10;Example: $n_%Y-%m-%d_$c"
            width="170">
              Available tokens?
          </text>
        </panel>
    </panel>
    <view_border
     bevel_style="none"
     follows="left|top|right"
     height="0"
     layout="topleft"
     left="10"
     name="preview_border"
     right="-10"
     top="98" />
    <text
     type="string"
     follows="left|top"
     height="16"
     layout="topleft"
     left="10"
     name="preview_old_label"
     top="102"
     width="70">
        Current:
    </text>
    <text
     type="string"
     follows="left|top|right"
     height="16"
     layout="topleft"
     left_pad="4"
     name="preview_old"
     parse_urls="false"
     right="-10"
     top_delta="0"
     use_ellipses="true" />
    <text
     type="string"
     follows="left|top"
     height="16"
     layout="topleft"
     left="10"
     name="preview_new_label"
     top_pad="4"
     width="70">
        New:
    </text>
    <text
     type="string"
     follows="left|top|right"
     height="16"
     layout="topleft"
     left_pad="4"
     name="preview_new"
     parse_urls="false"
     right="-10"
     top_delta="0"
     use_ellipses="true" />
    <button
     follows="right|bottom"
     height="22"
     label="OK"
     layout="topleft"
     name="btn_ok"
     right="-106"
     top="143"
     width="90" />
    <button
     follows="right|bottom"
     height="22"
     label="Cancel"
     layout="topleft"
     name="btn_cancel"
     right="-10"
     top_delta="0"
     width="90" />
</floater>
