<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="preview_texture">
	<floater.string name="Title">
		Tekstur: [NAME]
	</floater.string>
	<floater.string name="Copy">
		Kopiér til beholdning
	</floater.string>
	<text name="desc txt">
		Beskrivelse:
	</text>
	<text name="dimensions">
		[WIDTH]px x [HEIGHT]px
	</text>
	<layout_stack name="button_row_ls">
		<layout_panel name="aspect_combo_lp">
			<combo_box name="combo_aspect_ratio" tool_tip="Forhåndsvisning med et bestemt billedformat">
			</combo_box>
		</layout_panel>
		<layout_panel name="btn_save_lp">
			<button label="Gem som" name="save_tex_btn"/>
		</layout_panel>
		<layout_panel name="btn_discard_lp">
			<button label="Kassér" name="Discard"/>
		</layout_panel>
		<layout_panel name="btn_keep_lp">
			<button label="OK" name="Keep"/>
		</layout_panel>
	</layout_stack>
</floater>
