<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="floater_chat_alerts" title="Chat-nøgleordsmeddelelser">
	<sound_drop_target name="sound_drop_target"/>
	<check_box label="Aktivér meddelelser" name="alerts_check"/>
	<scroll_list draw_heading="true" name="alerts_list">
		<scroll_list.columns label="Nøgleord" name="alert_keyword"/>
	</scroll_list>
	<button label="Ny" name="alerts_new_btn"/>
	<button label="Slet" name="alerts_delete_btn"/>
	<view_border name="divisor"/>
	<text name="alerts_keyword_label">
		Nøgleord:
	</text>
	<line_editor name="alerts_keyword"/>
	<check_box label="Versalfølsom" name="alerts_keyword_case"/>
	<text name="alerts_color_label">
		Fremhævelsesfarve:
	</text>
	<color_swatch name="alerts_highlight_color"/>
	<text name="alerts_sound_label">
		Afspil lyd:
	</text>
	<line_editor label="Træk en genstand fra beholdning hertil" name="alerts_sound_name"/>
	<icon name="alerts_sound_icon"/>
	<button name="alerts_sound_clear_btn"/>
	<text name="alerts_trigger_label">
		Udløs på:
	</text>
	<check_box label="Chat" name="alerts_trigger_chat"/>
	<check_box label="IMs" name="alerts_trigger_im"/>
	<check_box label="Grupper" name="alerts_trigger_group"/>
	<button label="Gem ændringer" name="alerts_save_btn"/>
	<button label="Fortryd ændringer" name="alerts_revert_btn"/>
</floater>
