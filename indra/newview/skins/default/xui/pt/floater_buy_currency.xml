<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="buy currency" title="Comprar L$">
	<floater.string name="buy_currency">
		Compre L$ [LINDENS] por aprox. [LOCALAMOUNT]
	</floater.string>
	<text name="currency_links">
		[http://www.secondlife.com/my/account/payment_method_management.php método de pagamento] | [http://www.secondlife.com/my/account/currency.php moeda]
	</text>
	<floater.string name="info_cannot_buy">
		Transação incompleta
	</floater.string>
	<layout_stack name="outer_stack">
		<layout_panel name="layout_panel_buttons">
			<button label="Fechar" name="cancel_btn"/>
			<button label="Comprar já!" name="buy_btn"/>
			<text name="contacting">
		Contatando LindeX...
	</text>
		</layout_panel>
		<layout_panel name="layout_panel_msg">
			<text name="purchase_warning_repurchase">
		Confirmar esta transação compra somente L$, não o objeto.
	</text>
			<text name="exchange_rate_note">
		Digite o valor novamente para ver o câmbio atual.
	</text>
		</layout_panel>
		<layout_panel name="layout_panel_action">
			<text name="total_amount">
		L$ [AMT]
	</text>
			<text name="total_label">
		Saldo resultante:
	</text>
			<text name="getting_data">
		Calculando...
	</text>
			<text left_delta="72" name="currency_est">
		aprox. [LOCALAMOUNT]
	</text>
			<line_editor label="L$" left_delta="65" name="currency_amt" width="70">
				1234
			</line_editor>
			<text name="currency_label">
		L$
	</text>
			<text name="currency_action" width="60">
		Comprar
	</text>
		</layout_panel>
		<layout_panel name="layout_panel_balance">
			<text name="balance_amount">
		L$ [AMT]
	</text>
			<text name="balance_label">
		Tenho
	</text>
		</layout_panel>
		<layout_panel name="layout_panel_title">
			<text name="info_buying">
		Comprar L$
	</text>
			<text name="info_need_more">
		Você precisa de mais L$
	</text>
		</layout_panel>
	</layout_stack>
</floater>
