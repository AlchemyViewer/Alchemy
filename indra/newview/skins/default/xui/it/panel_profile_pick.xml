<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel name="panel_pick_info">
	<panel.string name="location_notice">
		(si aggiornerà dopo il salvataggio)
	</panel.string>
	<layout_stack name="main_pick_stack">
		<layout_panel name="save_changes_lp">
			<layout_stack name="save_changes_stack">
				<layout_panel name="save_btn_lp">
					<button label="Salva Luogo preferito" name="save_changes_btn"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="util_buttons_lp">
			<layout_stack name="util_buttons_stack">
				<layout_panel name="set_to_curr_location_btn_lp">
					<button label="Imposta Luogo" name="set_to_curr_location_btn" tool_tip="Imposta come Luogo Attuale"/>
				</layout_panel>
				<layout_panel name="tp_btn_lp">
					<button label="Teletrasporto" name="teleport_btn"/>
				</layout_panel>
				<layout_panel name="map_btn_lp">
					<button label="Mostra sulla mappa" name="show_on_map_btn"/>
				</layout_panel>
			</layout_stack>
		</layout_panel>
		<layout_panel name="main_pick_lp">
			<line_editor name="pick_location">
