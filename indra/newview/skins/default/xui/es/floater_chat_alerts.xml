<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="floater_chat_alerts" title="Avisos de palabras clave del chat">
	<sound_drop_target name="sound_drop_target"/>
	<check_box label="Activar avisos" name="alerts_check"/>
	<scroll_list draw_heading="true" name="alerts_list">
		<scroll_list.columns label="Palabra clave" name="alert_keyword"/>
	</scroll_list>
	<button label="Nuevo" name="alerts_new_btn"/>
	<button label="Eliminar" name="alerts_delete_btn"/>
	<view_border name="divisor"/>
	<text name="alerts_keyword_label">
		Palabra clave:
	</text>
	<line_editor name="alerts_keyword"/>
	<check_box label="Distinguir mayúsculas" name="alerts_keyword_case"/>
	<text name="alerts_color_label">
		Color de resaltado:
	</text>
	<color_swatch name="alerts_highlight_color"/>
	<text name="alerts_sound_label">
		Reproducir sonido:
	</text>
	<line_editor label="Arrastra un objeto de inventario aquí" name="alerts_sound_name"/>
	<icon name="alerts_sound_icon"/>
	<button name="alerts_sound_clear_btn"/>
	<text name="alerts_trigger_label">
		Activar en:
	</text>
	<check_box label="Chat" name="alerts_trigger_chat"/>
	<check_box label="MIs" name="alerts_trigger_im"/>
	<check_box label="Grupos" name="alerts_trigger_group"/>
	<button label="Guardar entrada" name="alerts_save_btn"/>
	<button label="Revertir entrada" name="alerts_revert_btn"/>
</floater>
