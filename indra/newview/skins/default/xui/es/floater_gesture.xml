	<floater.string name="no_matching_gestures">No hay gestos coincidentes</floater.string>
	<floater.string name="menu_activate">Activar</floater.string>
	<floater.string name="menu_deactivate">Desactivar</floater.string>
	<floater.string name="menu_play">Reproducir</floater.string>
	<floater.string name="menu_stop">Parar</floater.string>
	<filter_editor label="Filtrar por nombre, chat o tecla" name="gesture_filter" tool_tip="Filtrar gestos por nombre, palabra clave de chat o tecla de acceso directo"/>
	<scroll_list name="gesture_list">
		<scroll_list.columns label="Nombre" name="name"/>
		<scroll_list.columns label="Chat" name="trigger"/>
		<scroll_list.columns label="Tecla" name="shortcut"/>
