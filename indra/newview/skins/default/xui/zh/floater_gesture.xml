<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater label="地點" name="gestures" title="姿勢">
	<floater.string name="loading">
		載入中...
	</floater.string>
	<floater.string name="playing">
		（播放中）
	</floater.string>
	<floater.string name="copy_name">
		[COPY_NAME] 複本
	</floater.string>
	<floater.string name="never_used">---</floater.string>
	<floater.string name="last_used_seconds">[COUNT]秒</floater.string>
	<floater.string name="last_used_minutes">[COUNT]分</floater.string>
	<floater.string name="last_used_hours">[COUNT]小時</floater.string>
	<floater.string name="last_used_days">[COUNT]天</floater.string>
	<floater.string name="no_gestures">沒有姿勢</floater.string>
	<floater.string name="no_matching_gestures">沒有符合條件的姿勢</floater.string>
	<floater.string name="menu_activate">啟動</floater.string>
	<floater.string name="menu_deactivate">停用</floater.string>
	<floater.string name="menu_play">播放</floater.string>
	<floater.string name="menu_stop">停止</floater.string>
	<filter_editor label="依名稱、聊天或按鍵篩選" name="gesture_filter" tool_tip="依名稱、聊天觸發文字或快捷鍵篩選姿勢"/>
	<scroll_list name="gesture_list">
		<scroll_list.columns label="名稱" name="name"/>
		<scroll_list.columns label="聊天" name="trigger"/>
		<scroll_list.columns label="鍵" name="shortcut"/>
		<scroll_list.columns label="上次" name="last_used" tool_tip="本次工作階段中距離上次使用的時間。保留最近使用的 1,024 個姿勢記錄。按一下即可排序。"/>
	</scroll_list>
	<panel label="bottom_panel" name="bottom_panel">
		<menu_button name="gear_btn" tool_tip="更多選項"/>
		<button name="new_gesture_btn" tool_tip="製作新姿勢e"/>
		<button name="activate_btn" tool_tip="啟動/停止所選姿勢"/>
		<button name="del_btn" tool_tip="刪除這個姿勢"/>
	</panel>
	<button label="打開" name="edit_btn" tool_tip="開啓視窗以便編輯所選姿勢。"/>
	<button label="播放" name="play_btn" tool_tip="在虛擬世界裡執行所選姿勢。"/>
	<button label="停止" name="stop_btn"/>
</floater>
