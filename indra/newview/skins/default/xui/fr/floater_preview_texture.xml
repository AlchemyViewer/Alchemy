<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater name="preview_texture">
	<floater.string name="Title">
		Texture : [NAME]
	</floater.string>
	<floater.string name="Copy">
		Copier dans l&apos;inventaire
	</floater.string>
	<layout_stack name="button_row_ls">
		<layout_panel name="aspect_combo_lp">
			<combo_box name="combo_aspect_ratio" tool_tip="Prévisualiser avec un rapport d'aspect fixe"/>
		</layout_panel>
		<layout_panel name="btn_save_lp">
			<button label="Enregistrer sous" name="save_tex_btn"/>
		</layout_panel>
		<layout_panel name="btn_discard_lp">
			<button label="Jeter" name="Discard"/>
		</layout_panel>
		<layout_panel name="btn_keep_lp">
			<button label="OK" name="Keep"/>
		</layout_panel>
	</layout_stack>
	<text name="dimensions">
				[WIDTH]px x [HEIGHT]px
			</text>
	<text name="desc txt">
				Description :
			</text>
</floater>
