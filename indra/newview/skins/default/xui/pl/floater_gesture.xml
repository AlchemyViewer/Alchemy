<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater name="gestures" title="GESTY" label="Miejsca">
	<floater.string name="loading">
		Ładowanie...
	</floater.string>
	<floater.string name="playing">
		(Odtwarzanie)
	</floater.string>
	<floater.string name="copy_name">
		Kopia [COPY_NAME]
	</floater.string>
	<floater.string name="never_used">---</floater.string>
	<floater.string name="last_used_seconds">[COUNT]s</floater.string>
	<floater.string name="last_used_minutes">[COUNT]min</floater.string>
	<floater.string name="last_used_hours">[COUNT]h</floater.string>
	<floater.string name="last_used_days">[COUNT]d</floater.string>
	<floater.string name="no_gestures">Brak gestów</floater.string>
	<floater.string name="no_matching_gestures">Brak pasujących gestów</floater.string>
	<floater.string name="menu_activate">Aktywuj</floater.string>
	<floater.string name="menu_deactivate">Deaktywuj</floater.string>
	<floater.string name="menu_play">Odtwarzaj</floater.string>
	<floater.string name="menu_stop">Zatrzymaj</floater.string>
	<filter_editor label="Filtruj według nazwy, czatu lub klawisza" name="gesture_filter" tool_tip="Filtruj gesty według nazwy, tekstu wywołującego w czacie lub skrótu klawiszowego" />
	<scroll_list name="gesture_list">
		<scroll_list.columns label="Nazwa" name="name" />
		<scroll_list.columns label="Czat" name="trigger" />
		<scroll_list.columns label="Skrót" name="shortcut" />
		<scroll_list.columns label="Ostatnio" name="last_used" tool_tip="Czas od ostatniego użycia w tej sesji. Zapamiętuje 1 024 ostatnio używane gesty. Kliknij, aby posortować." width="64" />
	</scroll_list>
	<panel name="bottom_panel">
		<menu_button name="gear_btn" tool_tip="Więcej opcji" />
		<button name="new_gesture_btn" tool_tip="Stwórz nowy gest" />
		<button name="activate_btn" tool_tip="Aktywuj/Dezaktywuj wybrany gest" />
		<button name="del_btn" tool_tip="Usuń gest" />
	</panel>
	<button label="Otwórz" name="edit_btn" />
	<button label="Odtwarzaj" name="play_btn" />
	<button label="Zatrzymaj" name="stop_btn" />
</floater>
