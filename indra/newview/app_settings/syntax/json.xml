<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  A highlighting grammar for JSON, read by ALSyntaxGrammar (indra/llui).

  states: named lists of rules, tried in order at every position. A rule
  matches one of: match (a literal; whole_word to refuse it inside a word),
  chars (a class, with min and max; unicode for everything beyond ASCII),
  word (an identifier, looked up in `tables`, each a table and the kind a
  word found there is), span (an opening with an end, an escape, and
  multiline), span_regex with end_regex (where \1 stands for the opening's
  first capture), regex (anchored where it is tried), or eol (the line's
  end). It names the kind it makes and where it goes: push, pop or next.
  What nothing matches is one character of the state's default kind.

  words: the words the grammar itself puts in its tables; the language
  service adds the rest at runtime.

  indent: how the language indents -- opens, a pattern found at the end
  of the text before the caret, which sends a new line in a level, and
  closes, one matched at the start of a line's text, which brings the
  line out to the level of what opened it as it is typed.
-->
<llsd>
  <map>
    <key>name</key>
    <string>json</string>
    <key>extensions</key>
    <array>
      <string>json</string>
    </array>
    <key>indent</key>
    <map>
      <key>opens</key>
      <string>[{\[][ \t]*$</string>
      <key>closes</key>
      <string>[}\]]</string>
    </map>
    <key>words</key>
    <map>
      <key>constant</key>
      <array>
        <string>true</string>
        <string>false</string>
        <string>null</string>
      </array>
    </map>
    <key>states</key>
    <map>
      <key>main</key>
      <array>
        <map>
          <key>regex</key>
          <string>"(?:[^"\\]|\\.)*"(?=\s*:)</string>
          <key>kind</key>
          <string>property</string>
        </map>
        <map>
          <key>span</key>
          <string>"</string>
          <key>end</key>
          <string>"</string>
          <key>escape</key>
          <string>\</string>
          <key>kind</key>
          <string>string</string>
          <key>multiline</key>
          <boolean>0</boolean>
        </map>
        <map>
          <key>regex</key>
          <string>-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?</string>
          <key>kind</key>
          <string>number</string>
        </map>
        <map>
          <key>word</key>
          <boolean>1</boolean>
          <key>tables</key>
          <array>
            <map>
              <key>table</key>
              <string>constant</string>
              <key>kind</key>
              <string>constant</string>
            </map>
          </array>
        </map>
        <map>
          <key>chars</key>
          <string>{}[]:,</string>
          <key>max</key>
          <integer>1</integer>
          <key>kind</key>
          <string>punctuation</string>
        </map>
      </array>
    </map>
  </map>
</llsd>
