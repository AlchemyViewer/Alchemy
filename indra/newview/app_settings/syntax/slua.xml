<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  A highlighting grammar for SLua, read by ALSyntaxGrammar (indra/llui).

  states: named lists of rules, tried in order at every position. A rule
  matches one of: match (a literal; whole_word to refuse it inside a word),
  chars (a class, with min and max; unicode for everything beyond ASCII),
  word (an identifier, looked up in `tables`, each a table and the kind a
  word found there is; `qualified` looks `head.word` up first, for tables
  that name `ll.Say`), span (an opening with an end, an escape, and
  multiline), span_regex with end_regex (where \1 stands for the opening's
  first capture), regex (anchored where it is tried), or eol (the line's
  end; unless_after names what, ending a line, carries the state on to the
  next). It names the kind it makes and where it goes: push, pop or next.
  What nothing matches is one character of the state's default kind.

  words: the words the grammar itself puts in its tables; the language
  service adds the rest at runtime.

  indent: how the language indents. opens, a pattern found at the end
  of the text before the caret, which sends a new line in a level, and
  closes, one matched at the start of a line's text, which brings the
  line out to the level of what opened it as it is typed.
  pairs: the brackets and quotes typed in pairs, each its opener and
  its closer, which the editor closes as the opener is typed.
-->
<llsd>
  <map>
    <key>name</key>
    <string>slua</string>
    <key>pairs</key>
    <array>
      <string>()</string>
      <string>[]</string>
      <string>{}</string>
      <string>""</string>
      <string>''</string>
      <string>``</string>
    </array>
    <key>line_comment</key>
    <string>--</string>
    <key>extensions</key>
    <array>
      <string>luau</string>
      <string>lua</string>
    </array>
    <key>indent</key>
    <map>
      <key>opens</key>
      <string>(\b(then|do|else|repeat)|\bfunction\b(?!.*\bend\b).*\)([ \t]*:[^=]*)?|[{(\[])[ \t]*(--.*)?$</string>
      <key>closes</key>
      <string>(end|else|elseif|until)\b|[})\]]</string>
    </map>
    <key>words</key>
    <map>
      <key>control</key>
      <array>
        <string>and</string>
        <string>break</string>
        <string>continue</string>
        <string>do</string>
        <string>else</string>
        <string>elseif</string>
        <string>end</string>
        <string>for</string>
        <string>function</string>
        <string>if</string>
        <string>in</string>
        <string>local</string>
        <string>not</string>
        <string>or</string>
        <string>repeat</string>
        <string>return</string>
        <string>then</string>
        <string>until</string>
        <string>while</string>
      </array>
      <key>constant</key>
      <array>
        <string>true</string>
        <string>false</string>
        <string>nil</string>
      </array>
    </map>
    <key>states</key>
    <map>
      <key>main</key>
      <array>
        <map>
          <key>span_regex</key>
          <string>--\[(=*)\[</string>
          <key>end_regex</key>
          <string>\]\1\]</string>
          <key>kind</key>
          <string>comment</string>
        </map>
        <map>
          <key>match</key>
          <string>--</string>
          <key>kind</key>
          <string>comment</string>
          <key>push</key>
          <string>line_comment</string>
        </map>
        <map>
          <key>span_regex</key>
          <string>\[(=*)\[</string>
          <key>end_regex</key>
          <string>\]\1\]</string>
          <key>kind</key>
          <string>string</string>
        </map>
        <map>
          <key>span</key>
          <string>"</string>
          <key>end</key>
          <string>"</string>
          <key>escape</key>
          <string>\</string>
          <key>kind</key>
          <string>string</string>
          <key>multiline</key>
          <boolean>0</boolean>
        </map>
        <map>
          <key>span</key>
          <string>'</string>
          <key>end</key>
          <string>'</string>
          <key>escape</key>
          <string>\</string>
          <key>kind</key>
          <string>string</string>
          <key>multiline</key>
          <boolean>0</boolean>
        </map>
        <map>
          <key>match</key>
          <string>`</string>
          <key>kind</key>
          <string>string</string>
          <key>push</key>
          <string>template</string>
        </map>
        <map>
          <key>regex</key>
          <string>0[xX][0-9a-fA-F_]+</string>
          <key>kind</key>
          <string>number</string>
        </map>
        <map>
          <key>regex</key>
          <string>0[bB][01_]+</string>
          <key>kind</key>
          <string>number</string>
        </map>
        <map>
          <key>regex</key>
          <string>[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?|\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?</string>
          <key>kind</key>
          <string>number</string>
        </map>
        <map>
          <key>regex</key>
          <string>@[A-Za-z_][A-Za-z0-9_]*</string>
          <key>kind</key>
          <string>attribute</string>
        </map>
        <map>
          <key>regex</key>
          <string>(?&lt;![A-Za-z0-9_.:])export(?=\s+(local|const|function|type)\b)</string>
          <key>kind</key>
          <string>control</string>
        </map>
        <map>
          <key>regex</key>
          <string>(?&lt;![A-Za-z0-9_.:])const(?=\s+[A-Za-z_])</string>
          <key>kind</key>
          <string>control</string>
        </map>
        <map>
          <key>regex</key>
          <string>(?&lt;![A-Za-z0-9_.:])type(?=\s+[A-Za-z_][A-Za-z0-9_]*\s*[&lt;=])</string>
          <key>kind</key>
          <string>control</string>
        </map>
        <map>
          <key>word</key>
          <boolean>1</boolean>
          <key>qualified</key>
          <boolean>1</boolean>
          <key>tables</key>
          <array>
            <map>
              <key>table</key>
              <string>control</string>
              <key>kind</key>
              <string>control</string>
            </map>
            <map>
              <key>table</key>
              <string>type</string>
              <key>kind</key>
              <string>type</string>
            </map>
            <map>
              <key>table</key>
              <string>event</string>
              <key>kind</key>
              <string>event</string>
            </map>
            <map>
              <key>table</key>
              <string>function</string>
              <key>kind</key>
              <string>function</string>
            </map>
            <map>
              <key>table</key>
              <string>deprecated</string>
              <key>kind</key>
              <string>deprecated</string>
            </map>
            <map>
              <key>table</key>
              <string>constant</string>
              <key>kind</key>
              <string>constant</string>
            </map>
          </array>
        </map>
        <map>
          <key>chars</key>
          <string>+\-*/%^#=~&lt;&gt;&amp;|?</string>
          <key>kind</key>
          <string>operator</string>
        </map>
        <map>
          <key>chars</key>
          <string>(){}[];:,.</string>
          <key>max</key>
          <integer>1</integer>
          <key>kind</key>
          <string>punctuation</string>
        </map>
      </array>
      <key>line_comment</key>
      <map>
        <key>default</key>
        <string>comment</string>
        <key>rules</key>
        <array>
          <map>
            <key>eol</key>
            <boolean>1</boolean>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
        </array>
      </map>
      <key>template</key>
      <map>
        <key>default</key>
        <string>string</string>
        <key>rules</key>
        <array>
          <map>
            <key>regex</key>
            <string>\\.</string>
            <key>kind</key>
            <string>escape</string>
          </map>
          <map>
            <key>match</key>
            <string>`</string>
            <key>kind</key>
            <string>string</string>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
          <map>
            <key>match</key>
            <string>{</string>
            <key>kind</key>
            <string>punctuation</string>
            <key>push</key>
            <string>interpolation</string>
          </map>
          <map>
            <key>eol</key>
            <boolean>1</boolean>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
        </array>
      </map>
      <key>interpolation</key>
      <map>
        <key>default</key>
        <string>text</string>
        <key>rules</key>
        <array>
          <map>
            <key>match</key>
            <string>}</string>
            <key>kind</key>
            <string>punctuation</string>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
          <map>
            <key>span</key>
            <string>"</string>
            <key>end</key>
            <string>"</string>
            <key>escape</key>
            <string>\</string>
            <key>kind</key>
            <string>string</string>
            <key>multiline</key>
            <boolean>0</boolean>
          </map>
          <map>
            <key>span</key>
            <string>'</string>
            <key>end</key>
            <string>'</string>
            <key>escape</key>
            <string>\</string>
            <key>kind</key>
            <string>string</string>
            <key>multiline</key>
            <boolean>0</boolean>
          </map>
          <map>
            <key>regex</key>
            <string>0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9][0-9_]*(\.[0-9_]*)?([eE][+-]?[0-9_]+)?</string>
            <key>kind</key>
            <string>number</string>
          </map>
          <map>
            <key>word</key>
            <boolean>1</boolean>
            <key>qualified</key>
            <boolean>1</boolean>
            <key>tables</key>
            <array>
              <map>
                <key>table</key>
                <string>control</string>
                <key>kind</key>
                <string>control</string>
              </map>
              <map>
                <key>table</key>
                <string>type</string>
                <key>kind</key>
                <string>type</string>
              </map>
              <map>
                <key>table</key>
                <string>function</string>
                <key>kind</key>
                <string>function</string>
              </map>
              <map>
                <key>table</key>
                <string>deprecated</string>
                <key>kind</key>
                <string>deprecated</string>
              </map>
              <map>
                <key>table</key>
                <string>constant</string>
                <key>kind</key>
                <string>constant</string>
              </map>
            </array>
          </map>
          <map>
            <key>chars</key>
            <string>+\-*/%^#=~&lt;&gt;&amp;|?</string>
            <key>kind</key>
            <string>operator</string>
          </map>
          <map>
            <key>chars</key>
            <string>()[];:,.</string>
            <key>max</key>
            <integer>1</integer>
            <key>kind</key>
            <string>punctuation</string>
          </map>
          <map>
            <key>eol</key>
            <boolean>1</boolean>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
        </array>
      </map>
    </map>
  </map>
</llsd>
