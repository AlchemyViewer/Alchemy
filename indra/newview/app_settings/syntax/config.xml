<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  A highlighting grammar for a notecard of settings, read by ALSyntaxGrammar
  (indra/llui): a line is a comment (#, // or ;), a [section], or
  key = value (or key: value), which is what scripts that read a notecard
  of settings most often read.

  states: named lists of rules, tried in order at every position. A rule
  matches one of: match (a literal; whole_word to refuse it inside a word),
  chars (a class, with min and max; unicode for everything beyond ASCII),
  word (an identifier, looked up in `tables`, each a table and the kind a
  word found there is), span (an opening with an end, an escape, and
  multiline), span_regex with end_regex (where \1 stands for the opening's
  first capture), regex (anchored where it is tried; not_after_chars, a
  class the character before it may not be in, and consume, the group that
  is the token, the rest of the match only read), or eol (the line's end;
  unless_after names what, ending a line, carries the state on to the
  next). It names the kind it makes and where it goes: push, pop or next.
  What nothing matches is one character of the state's default kind.
  Patterns are RE2's, which has no lookaround and no backreference:
  not_after_chars, consume and an opener's unless stand in for them.

  words: the words the grammar itself puts in its tables; the language
  service adds the rest at runtime.

-->
<llsd>
  <map>
    <key>name</key>
    <string>config</string>
    <key>extensions</key>
    <array>
      <string>ini</string>
      <string>cfg</string>
    </array>
    <key>words</key>
    <map>
      <key>constant</key>
      <array>
        <string>true</string>
        <string>false</string>
        <string>TRUE</string>
        <string>FALSE</string>
        <string>yes</string>
        <string>no</string>
        <string>on</string>
        <string>off</string>
      </array>
    </map>
    <key>states</key>
    <map>
      <key>main</key>
      <array>
        <map>
          <key>regex</key>
          <string>[ \t]*(#|//|;).*</string>
          <key>kind</key>
          <string>comment</string>
        </map>
        <map>
          <key>regex</key>
          <string>\[[^\]]*\]</string>
          <key>kind</key>
          <string>type</string>
        </map>
        <!-- A key, up to the = or : after it, which the next state takes. -->
        <map>
          <key>regex</key>
          <string>([^=:#;\s][^=:]*?)[ \t]*[=:]</string>
          <key>consume</key>
          <integer>1</integer>
          <key>kind</key>
          <string>property</string>
          <key>push</key>
          <string>separator</string>
        </map>
      </array>
      <key>separator</key>
      <map>
        <key>default</key>
        <string>text</string>
        <key>rules</key>
        <array>
          <map>
            <key>regex</key>
            <string>[ \t]*[=:]</string>
            <key>kind</key>
            <string>punctuation</string>
            <key>next</key>
            <string>value</string>
          </map>
          <map>
            <key>eol</key>
            <boolean>1</boolean>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
        </array>
      </map>
      <key>value</key>
      <map>
        <key>default</key>
        <string>text</string>
        <key>rules</key>
        <array>
          <map>
            <key>span</key>
            <string>"</string>
            <key>end</key>
            <string>"</string>
            <key>escape</key>
            <string>\</string>
            <key>kind</key>
            <string>string</string>
            <key>multiline</key>
            <boolean>0</boolean>
          </map>
          <!-- A key, as scripts write one. -->
          <map>
            <key>regex</key>
            <string>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}</string>
            <key>kind</key>
            <string>constant</string>
          </map>
          <map>
            <key>regex</key>
            <string>-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?</string>
            <key>not_after_chars</key>
            <string>A-Za-z_</string>
            <key>kind</key>
            <string>number</string>
          </map>
          <map>
            <key>word</key>
            <boolean>1</boolean>
            <key>tables</key>
            <array>
              <map>
                <key>table</key>
                <string>constant</string>
                <key>kind</key>
                <string>constant</string>
              </map>
            </array>
          </map>
          <map>
            <key>chars</key>
            <string>&lt;&gt;,</string>
            <key>max</key>
            <integer>1</integer>
            <key>kind</key>
            <string>punctuation</string>
          </map>
          <map>
            <key>eol</key>
            <boolean>1</boolean>
            <key>pop</key>
            <boolean>1</boolean>
          </map>
        </array>
      </map>
    </map>
  </map>
</llsd>
