<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Script Studio's snippets for SLua: what Insert > Snippet offers, and
  what completing the prefix offers among the words. Each is a name, the
  prefix that completes to it, a line about it, and the body, where
  ${1:text} is a placeholder to tab through (numbered in the order
  they are visited, with text to type over or none), $0 is where the
  caret lands past the last, and $$ is a dollar. The lines after the
  first are indented as the line the snippet goes into is, and each
  level of their own, four spaces or a tab, becomes a level of the
  script's own indentation, tabs or spaces.

  A file of the same name under the settings folder's snippets/ adds a
  person's own.
-->
<llsd>
  <array>
    <map>
      <key>name</key>
      <string>function</string>
      <key>prefix</key>
      <string>function</string>
      <key>detail</key>
      <string>A function</string>
      <key>body</key>
      <string>function ${1:name}(${2})
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>local function</string>
      <key>prefix</key>
      <string>lfunction</string>
      <key>detail</key>
      <string>A local function</string>
      <key>body</key>
      <string>local function ${1:name}(${2})
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>if</string>
      <key>prefix</key>
      <string>if</string>
      <key>detail</key>
      <string>An if</string>
      <key>body</key>
      <string>if ${1:condition} then
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>if / else</string>
      <key>prefix</key>
      <string>ifelse</string>
      <key>detail</key>
      <string>An if and an else</string>
      <key>body</key>
      <string>if ${1:condition} then
    $2
else
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>elseif</string>
      <key>prefix</key>
      <string>elseif</string>
      <key>detail</key>
      <string>An elseif</string>
      <key>body</key>
      <string>elseif ${1:condition} then
    $0</string>
    </map>
    <map>
      <key>name</key>
      <string>for</string>
      <key>prefix</key>
      <string>for</string>
      <key>detail</key>
      <string>A counted loop</string>
      <key>body</key>
      <string>for ${1:i} = ${2:1}, ${3:count} do
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>for in</string>
      <key>prefix</key>
      <string>forin</string>
      <key>detail</key>
      <string>A loop over a table</string>
      <key>body</key>
      <string>for ${1:k}, ${2:v} in ${3:table} do
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>while</string>
      <key>prefix</key>
      <string>while</string>
      <key>detail</key>
      <string>A while loop</string>
      <key>body</key>
      <string>while ${1:condition} do
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>repeat</string>
      <key>prefix</key>
      <string>repeat</string>
      <key>detail</key>
      <string>A repeat loop, tested after</string>
      <key>body</key>
      <string>repeat
    $0
until ${1:condition}</string>
    </map>
    <map>
      <key>name</key>
      <string>event</string>
      <key>prefix</key>
      <string>event</string>
      <key>detail</key>
      <string>A handler for one of the object's events</string>
      <key>body</key>
      <string>function LLEvents.${1:touch_start}(${2:detected})
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>timer</string>
      <key>prefix</key>
      <string>timer</string>
      <key>detail</key>
      <string>A callback every so many seconds</string>
      <key>body</key>
      <string>LLTimers:every(${1:1.0}, function()
    $0
end)</string>
    </map>
    <map>
      <key>name</key>
      <string>once</string>
      <key>prefix</key>
      <string>once</string>
      <key>detail</key>
      <string>A callback once, after so many seconds</string>
      <key>body</key>
      <string>LLTimers:once(${1:1.0}, function()
    $0
end)</string>
    </map>
    <map>
      <key>name</key>
      <string>require</string>
      <key>prefix</key>
      <string>require</string>
      <key>detail</key>
      <string>A module from the object's contents</string>
      <key>body</key>
      <string>local ${1:name} = require("${2:module}")</string>
    </map>
    <map>
      <key>name</key>
      <string>listen</string>
      <key>prefix</key>
      <string>listen</string>
      <key>detail</key>
      <string>Open a channel and handle what is said on it</string>
      <key>body</key>
      <string>ll.Listen(${1:0}, "", "", "")
function LLEvents.listen(channel: number, name: string, id: uuid, text: string)
    $0
end</string>
    </map>
    <map>
      <key>name</key>
      <string>type</string>
      <key>prefix</key>
      <string>type</string>
      <key>detail</key>
      <string>A type alias</string>
      <key>body</key>
      <string>type ${1:Name} = ${2:{\}}</string>
    </map>
  </array>
</llsd>
