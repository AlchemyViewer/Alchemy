<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@AL_APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LGPL-2.1-only</project_license>
  <name>@AL_APP_NAME@</name>
  <summary>Visit Second Life and other virtual worlds</summary>
  <description>
    <p>
      Alchemy is a third-party viewer for Second Life and OpenSimulator grids,
      built on Linden Lab's viewer with a modern renderer, post-processing,
      and a script editor of its own.
    </p>
  </description>
  <launchable type="desktop-id">@AL_APP_ID@.desktop</launchable>
  <developer id="org.alchemyviewer">
    <name>Alchemy Viewer Project</name>
  </developer>
  <url type="homepage">https://www.alchemyviewer.org</url>
  <url type="bugtracker">https://github.com/AlchemyViewer/Alchemy/issues</url>
  <categories>
    <category>Game</category>
    <category>Simulation</category>
  </categories>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
    <content_attribute id="money-purchasing">intense</content_attribute>
  </content_rating>
  <releases>
    <release version="@VIEWER_SHORT_VERSION@.@VIEWER_VERSION_REVISION@" date="@al_release_date@"/>
  </releases>
</component>
